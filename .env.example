# ==============================================================================
# Capri DMC / Capri Tour Guide — Environment Configuration
# ==============================================================================

# Google Analytics 4 Measurement ID (es. G-XXXXXXXXXX)
# Gratuito su Google Analytics > Amministrazione > Flussi di dati
PUBLIC_GA_MEASUREMENT_ID=G-CAPRITOUR0

# Google Search Console Verification Token (meta tag content)
# Gratuito su Google Search Console > Impostazioni > Verifica della proprietà > Tag HTML
PUBLIC_GSC_TOKEN=

# Google Tag Manager Container ID (es. GTM-XXXXXXX) - Opzionale se usi GA4 diretto
PUBLIC_GTM_ID=

# Bing Webmaster Tools Verification Token - Opzionale
PUBLIC_BING_TOKEN=

# Environment mode: 'production' | 'preview'
PUBLIC_ENV=production
