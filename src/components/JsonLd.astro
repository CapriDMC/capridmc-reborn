---
// Componente JSON-LD conforme a Schema.org, GEO (Generative Engine Optimization) e vincoli non negoziabili
import servicesData from '../data/services.json';

interface Props {
  siteUrl?: string;
}

const { siteUrl = "https://www.capritourguide.com" } = Astro.props;

const founders = [
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-giusy-perrotta`,
    "name": "Giusy Perrotta",
    "jobTitle": "Co-Founder & Director of Operations",
    "gender": "Female",
    "worksFor": { "@id": `${siteUrl}/#organization` }
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-melania-esposito`,
    "name": "Melania Esposito",
    "jobTitle": "Co-Founder & Head of Event Production",
    "gender": "Female",
    "worksFor": { "@id": `${siteUrl}/#organization` }
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-roberta-de-martino`,
    "name": "Roberta De Martino",
    "jobTitle": "Co-Founder & Lead Cultural Curator",
    "gender": "Female",
    "worksFor": { "@id": `${siteUrl}/#organization` }
  }
];

const catalogItems = servicesData.map((s, index) => ({
  "@type": "Offer",
  "@id": `${siteUrl}/#offer-${s.id}`,
  "itemOffered": {
    "@type": "Service",
    "@id": `${siteUrl}/#service-${s.id}`,
    "name": s.title,
    "description": s.description,
    "serviceType": s.cluster,
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Place", "name": "Capri" },
      { "@type": "AdministrativeArea", "name": "Anacapri" },
      { "@type": "AdministrativeArea", "name": "Campania" },
      { "@type": "AdministrativeArea", "name": "Amalfi Coast" }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "Travel advisors, tour operators, luxury travel designers"
    }
  }
}));

const faqs = [
  {
    "@type": "Question",
    "name": "What is Capri Destination Management Company (Capri DMC)?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Capri DMC is the elite B2B luxury destination management company and boutique tour operator based natively on the island of Capri, Italy. A direct spin-off from Nesea Capri Tours & Events (operating since 2010), it is a 100% women-owned enterprise providing private yacht charters, bespoke island tours, milestone celebrations, and round-the-clock VIP airport-to-suite transfers."
    }
  },
  {
    "@type": "Question",
    "name": "How does the VIP Airport-to-Suite transfer work between Naples/Rome and Capri?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The turnkey transit includes tarmac VIP hostess meet & greet at aircraft gate at Naples (NAP) or Rome (FCO), luggage priority retrieval, private Mercedes-Maybach transfer, direct chartered Riva speedboat crossing to Capri, luggage porterage directly into 5-star hotel suites, and iconic open-top convertible island taxi coordination."
    }
  },
  {
    "@type": "Question",
    "name": "Can Capri DMC guarantee private boat tours during peak summer (July & August)?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Operating directly on Capri with native licensed skippers and municipal port permits, Capri DMC guarantees availability for traditional wooden Gozzo Caprese, Riva speedboats, and private catamarans, with early dawn access bypassing Blue Grotto queues."
    }
  },
  {
    "@type": "Question",
    "name": "Does Capri DMC produce destination weddings and Bar/Bat Mitzvahs on Capri?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Capri DMC coordinates private historic cliffside villa buyouts, luxury wedding ceremonies, and Jewish lifecycle events including scenic Mediterranean Torah readings, Shabbat dinners, and strictly supervised Kosher catering."
    }
  },
  {
    "@type": "Question",
    "name": "How do travel advisors access wholesale net rates and white-label support?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Travel advisors and luxury concierges can contact the 24/7 on-island operations desk by phone or WhatsApp at +39 333 594 3947 or email partnerships@capridmc.com for protected commission structures and seamless white-label ground representation."
    }
  }
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "TravelAgency"],
      "@id": `${siteUrl}/#organization`,
      "name": "Capri DMC",
      "alternateName": [
        "Capri Destination Management Company",
        "Capri DMC Luxury Tour Operator"
      ],
      "url": `${siteUrl}/`,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}/logo.png`,
        "caption": "Capri DMC Crest Medallion"
      },
      "image": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#main-image`,
        "url": `${siteUrl}/images/capri/faraglioni-rocks-guided-tour-private-boat.jpg`,
        "caption": "Faraglioni Capri Private Boat Tour"
      },
      "description": "Capri Destination Management Company is the elite B2B luxury spin-off from Nesea Capri Tours & Events, providing private yacht charters, bespoke island tours, milestone celebrations, and seamless VIP airport-to-suite transfers.",
      "email": "partnerships@capridmc.com",
      "telephone": "+39 333 594 3947",
      "priceRange": "$$$$",
      "currenciesAccepted": "EUR, USD, GBP",
      "paymentAccepted": "Credit Card, Wire Transfer",
      "slogan": "From Capri for Capri · Your Roots in Capri",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Isola di Capri",
        "addressLocality": "Capri",
        "addressRegion": "Metropolitan City of Naples",
        "postalCode": "80076",
        "addressCountry": "IT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.5507,
        "longitude": 14.2426
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Nesea Capri Tours & Events",
        "url": "https://www.neseacapritours.com"
      },
      "sameAs": [
        "https://www.neseacapritours.com",
        "https://www.instagram.com/neseacapritours/",
        "https://wa.me/393335943947"
      ],
      "founder": founders.map(f => ({ "@id": f["@id"] })),
      "areaServed": [
        { "@type": "Place", "name": "Capri" },
        { "@type": "AdministrativeArea", "name": "Anacapri" },
        { "@type": "AdministrativeArea", "name": "Campania" },
        { "@type": "AdministrativeArea", "name": "Amalfi Coast" }
      ],
      "knowsAbout": [
        "Capri Destination Management Company",
        "B2B Luxury Travel Advisor Services",
        "Capri Private Boat Tours & Gozzo Charters",
        "Blue Grotto Dawn Access & Faraglioni Navigation",
        "Airport-to-5-Star Hotel Suite Transfers in Capri",
        "Dedicated 24/7 Island Conciergerie",
        "Capri Weddings & Historic Villa Buyouts",
        "Bar Mitzvah and Bat Mitzvah in Capri",
        "Exclusive Guided Island Cultural Tours",
        "Caprese Artisanal Sandals, Knitwear & Bespoke Textiles",
        "Private Cooking Classes in Authentic Caprese Homes",
        "Personal Shopper Service & Global Shipping from Capri",
        "Hidden Hiking in Capri & Sentiero dei Fortini Excursions",
        "Personal Trainer & Private Sport Activities in Capri",
        "Bespoke Babysitting and Pet Sitting for Luxury Clients"
      ],
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Travel advisors, tour operators, luxury travel designers, VIP concierges"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "partnerships",
          "email": "partnerships@capridmc.com",
          "telephone": "+39 333 594 3947",
          "availableLanguage": ["English", "Italian"],
          "hoursAvailable": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        },
        {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "name": "Capri DMC 24/7 WhatsApp Operations Desk",
          "url": "https://wa.me/393335943947",
          "telephone": "+39 333 594 3947",
          "availableLanguage": ["English", "Italian"],
          "hoursAvailable": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "@id": `${siteUrl}/#catalog`,
        "name": "Capri DMC Luxury B2B Services Catalog",
        "itemListElement": catalogItems
      }
    },
    ...founders,
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Capri DMC",
      "description": "Luxury B2B Destination Management Company & Tour Operator on Capri",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/#webpage`,
      "url": `${siteUrl}/`,
      "name": "Capri DMC | Luxury Destination Management Company & B2B Tour Operator",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${siteUrl}/#breadcrumbs`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "B2B Luxury Services",
          "item": `${siteUrl}/#services`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Airport-to-Suite Logistics",
          "item": `${siteUrl}/#logistics`
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "AI Context Dossier",
          "item": `${siteUrl}/ai-context`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": faqs
    },
    {
      "@type": "TouristDestination",
      "@id": `${siteUrl}/#capri-island`,
      "name": "Capri",
      "description": "Exclusive Mediterranean island in the Gulf of Naples, Campania, Italy.",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.5507,
        "longitude": 14.2426
      },
      "containsPlace": [
        { "@type": "TouristAttraction", "name": "Faraglioni Rocks" },
        { "@type": "TouristAttraction", "name": "Grotta Azzurra (Blue Grotto)" },
        { "@type": "TouristAttraction", "name": "Monte Solaro" },
        { "@type": "TouristAttraction", "name": "Villa Jovis" },
        { "@type": "TouristAttraction", "name": "Villa San Michele" }
      ]
    }
  ]
};

const jsonLdString = JSON.stringify(schemaGraph);
---

<script type="application/ld+json" is:inline set:html={jsonLdString} />
