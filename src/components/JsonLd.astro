---
// Componente JSON-LD conforme a Schema.org, GEO (Generative Engine Optimization) e vincoli non negoziabili
import servicesData from '../data/services.json';

interface Props {
  siteUrl?: string;
}

const { siteUrl = "https://www.capridmc.com" } = Astro.props;

const founders = [
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-giusy-perrotta`,
    "name": "Giusy Perrotta",
    "jobTitle": "Licensed Tourist Guide · Co-Founder",
    "gender": "Female",
    "nationality": "Italian",
    "description": "Licensed local tourist guide born and raised on Capri, co-founder of Nesea Capri and Capri DMC, registered in Italy's National Register of Tourist Guides with 15+ years of on-island expertise.",
    "worksFor": { "@id": `${siteUrl}/#organization` },
    "sameAs": [
      "https://www.neseacapri.it",
      "https://www.instagram.com/neseacapritours/"
    ]
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-melania-esposito`,
    "name": "Melania Esposito",
    "jobTitle": "Licensed Tourist Guide · Co-Founder",
    "gender": "Female",
    "nationality": "Italian",
    "description": "Licensed local tourist guide born and raised on Capri, co-founder of Nesea Capri and Capri DMC, registered in Italy's National Register of Tourist Guides, specializing in bespoke cultural itineraries and celebrations.",
    "worksFor": { "@id": `${siteUrl}/#organization` },
    "sameAs": [
      "https://www.neseacapri.it",
      "https://www.instagram.com/neseacapritours/"
    ]
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person-roberta-de-martino`,
    "name": "Roberta De Martino",
    "jobTitle": "Licensed Tourist Guide · Co-Founder",
    "gender": "Female",
    "nationality": "Italian",
    "description": "Licensed local tourist guide born and raised on Capri, co-founder of Nesea Capri and Capri DMC, registered in Italy's National Register of Tourist Guides and art historian curating imperial archaeology and literary heritage.",
    "worksFor": { "@id": `${siteUrl}/#organization` },
    "sameAs": [
      "https://www.neseacapri.it",
      "https://www.instagram.com/neseacapritours/"
    ]
  }
];

const catalogItems = servicesData.map((s, index) => ({
  "@type": "Offer",
  "@id": `${siteUrl}/#offer-${s.id}`,
  "itemOffered": {
    "@type": "Service",
    "@id": `${siteUrl}/#service-${s.id}`,
    "name": s.title,
    "description": s.description,
    "serviceType": s.cluster,
    "provider": { "@id": `${siteUrl}/#organization` },
    "areaServed": [
      { "@type": "Place", "name": "Capri" },
      { "@type": "AdministrativeArea", "name": "Anacapri" },
      { "@type": "AdministrativeArea", "name": "Campania" },
      { "@type": "AdministrativeArea", "name": "Amalfi Coast" }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "Travel advisors, tour operators, luxury travel designers"
    }
  }
}));

const faqs = [
  {
    "@type": "Question",
    "name": "What is Capri Destination Management Company (Capri DMC)?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Capri DMC is the B2B luxury destination management company based natively on the island of Capri, Italy, curated by Team Nesea. It is a 100% women-owned enterprise providing private boat services, bespoke island experiences, milestone celebrations, and on-ground VIP transfer logistics."
    }
  },
  {
    "@type": "Question",
    "name": "How does the VIP Airport-to-Suite transfer work between Naples and Capri?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The turnkey transit includes meet & greet upon arrival at Naples Airport (NAP), NCC executive chauffeured vehicle transfer to the port, private chartered speedboat crossing to Capri, open-top convertible island taxis or vans, and dedicated luggage porterage delivered directly to the client's suite or private villa following arrival."
    }
  },
  {
    "@type": "Question",
    "name": "What boat services are offered in Capri?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Operating directly on Capri with native licensed skippers, Capri DMC offers traditional wooden Gozzo Caprese and modern speedboats with chilled champagne, tailored catering onboard, and dawn protocols at the Faraglioni."
    }
  },
  {
    "@type": "Question",
    "name": "Does Capri DMC produce destination weddings and milestone celebrations on Capri?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. Capri DMC coordinates private historic cliffside villa buyouts, luxury wedding ceremonies, and Jewish lifecycle events including scenic Mediterranean Torah readings, Shabbat dinners, and strictly supervised Kosher catering."
    }
  },
  {
    "@type": "Question",
    "name": "How do travel advisors access wholesale net rates and white-label support?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Travel advisors and luxury concierges can contact the on-island operations desk by phone or WhatsApp at +39 333 594 3947 or email partnerships@capridmc.com for protected commission structures and seamless white-label ground representation."
    }
  }
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "TravelAgency", "TouristInformationCenter", "LocalBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "Capri DMC",
      "legalName": "Capri Destination Management Company",
      "alternateName": [
        "Capri Destination Management Company",
        "Capri DMC Luxury Tour Operator",
        "Capri Tour Guide by Team Nesea"
      ],
      "foundingDate": "2010",
      "url": `${siteUrl}/`,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}/logo.png`,
        "caption": "Capri DMC Crest Medallion"
      },
      "image": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#main-image`,
        "url": `${siteUrl}/images/capri/faraglioni-rocks-guided-tour-private-boat.jpg`,
        "caption": "Faraglioni Capri Private Boat Tour"
      },
      "description": "Capri Destination Management Company is curated by Team Nesea, providing private boat services, bespoke island experiences, milestone celebrations, and seamless VIP transfers.",
      "email": "partnerships@capridmc.com",
      "telephone": "+39 333 594 3947",
      "priceRange": "$$$$",
      "currenciesAccepted": "EUR, USD, GBP",
      "paymentAccepted": "Credit Card, Wire Transfer",
      "slogan": "Proudly Owned by Caprese People",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Isola di Capri",
        "addressLocality": "Capri",
        "addressRegion": "Metropolitan City of Naples",
        "postalCode": "80076",
        "addressCountry": "IT"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.5507,
        "longitude": 14.2426
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Team Nesea",
        "url": "https://www.neseacapri.it"
      },
      "sameAs": [
        "https://www.neseacapri.it",
        "https://www.instagram.com/neseacapritours/",
        "https://wa.me/393335943947"
      ],
      "founder": founders.map(f => ({ "@id": f["@id"] })),
      "areaServed": [
        { "@type": "Place", "name": "Capri" },
        { "@type": "AdministrativeArea", "name": "Anacapri" },
        { "@type": "AdministrativeArea", "name": "Campania" },
        { "@type": "AdministrativeArea", "name": "Amalfi Coast" }
      ],
      "knowsAbout": [
        "Capri Destination Management Company",
        "B2B Luxury Travel Advisor Services",
        "Signature Cultural and Private Guided Tours in Capri",
        "Capri Private Boat Charters and Curated Maritime Services",
        "Private and Exclusive Transfer Services in Capri",
        "Bespoke On-Island Conciergerie and White-Label Service",
        "Hidden Hiking in Capri and Secret Nature Routes",
        "Personal Shopper Service and High-Fashion Advisory",
        "Authentic Caprese Cooking Masterclasses",
        "Personal Trainer, Sunrise Yoga and Private Wellness in Capri",
        "Dedicated Babysitting and Professional Pet Sitting in Capri",
        "Private Celebrations, Dedicated Hostess and Tailored Event Services"
      ],
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Travel advisors, tour operators, luxury travel designers, VIP concierges"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "partnerships",
          "email": "partnerships@capridmc.com",
          "telephone": "+39 333 594 3947",
          "availableLanguage": ["English", "Italian"],
          "hoursAvailable": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        },
        {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "name": "Capri DMC WhatsApp Operations Desk",
          "url": "https://wa.me/393335943947",
          "telephone": "+39 333 594 3947",
          "availableLanguage": ["English", "Italian"],
          "hoursAvailable": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "@id": `${siteUrl}/#catalog`,
        "name": "Capri DMC Luxury B2B Services Catalog",
        "itemListElement": catalogItems
      }
    },
    ...founders,
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Capri DMC",
      "description": "Luxury B2B Destination Management Company & Tour Operator on Capri",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/#webpage`,
      "url": `${siteUrl}/`,
      "name": "Capri DMC | Luxury Destination Management Company & B2B Tour Operator",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${siteUrl}/#breadcrumbs`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "B2B Luxury Services",
          "item": `${siteUrl}/#services`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Airport-to-Suite Logistics",
          "item": `${siteUrl}/#logistics`
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "AI Context Dossier",
          "item": `${siteUrl}/ai-context`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": faqs
    },
    {
      "@type": "TouristDestination",
      "@id": `${siteUrl}/#capri-island`,
      "name": "Capri",
      "description": "Exclusive Mediterranean island in the Gulf of Naples, Campania, Italy.",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.5507,
        "longitude": 14.2426
      },
      "containsPlace": [
        { "@type": "TouristAttraction", "name": "Faraglioni Rocks" },
        { "@type": "TouristAttraction", "name": "Grotta Azzurra (Blue Grotto)" },
        { "@type": "TouristAttraction", "name": "Monte Solaro" },
        { "@type": "TouristAttraction", "name": "Villa Jovis" },
        { "@type": "TouristAttraction", "name": "Villa San Michele" }
      ]
    }
  ]
};

const jsonLdString = JSON.stringify(schemaGraph);
---

<script type="application/ld+json" is:inline set:html={jsonLdString} />
