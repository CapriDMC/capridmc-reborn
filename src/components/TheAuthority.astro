---
// "The Local Authority" Pinned Editorial Storytelling Section with Authentic Team & Lineage
const contactUrl = "https://www.capridmc.com/contact-us-capri-destination-management-company/";

const teamFounders = [
  { name: "Giusy Perrotta", role: "Co-Founder & Director of Operations", note: "Native Caprese with 15+ years orchestrating maritime logistics and VIP advisor relations." },
  { name: "Melania Esposito", role: "Co-Founder & Head of Event Production", note: "Specialist in private historic villa buyouts, weddings, and Jewish milestone celebrations." },
  { name: "Roberta De Martino", role: "Co-Founder & Lead Cultural Curator", note: "Licensed art historian leading exclusive cultural itineraries and high-level island protocol." }
];
---

<section id="story" class="relative bg-white text-brand-navy border-b border-gray-100 flex flex-col md:flex-row">
  
  <!-- Left Side: Pinned on Desktop via GSAP ScrollTrigger -->
  <div
    id="story-left"
    class="md:w-5/12 lg:w-5/12 flex flex-col justify-between p-8 sm:p-12 lg:p-20 bg-brand-offwhite border-r border-gray-200/80 min-h-[50vh] md:min-h-screen"
  >
    <div class="story-left-content max-w-lg">
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-2.5 h-[1px] bg-brand-gold"></span>
        <span class="text-brand-gold uppercase tracking-[0.3em] text-[11px] font-semibold">
          The Local Authority
        </span>
      </div>

      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.08] text-brand-navy font-normal mb-8">
        Your Team in Capri. <br />
        The best partner to plan <br />
        <span class="italic text-brand-gold">your trip.</span>
      </h2>

      <p class="text-gray-600 font-light text-base lg:text-lg leading-relaxed mb-8">
        Since 2010, our founders have woven their lives into the island's fabric. We are the direct bridge between global luxury travel designers and the authentic heartbeat of Capri.
      </p>

      <div class="pt-6 border-t border-gray-200/80 hidden lg:block">
        <div class="flex items-center gap-4 text-xs tracking-wider text-brand-navy/80 uppercase font-semibold">
          <span class="px-3 py-1 bg-brand-navy text-white text-[10px]">Spin-Off</span>
          <span>From Nesea Capri Tours & Events</span>
        </div>
      </div>
    </div>

    <!-- Pinned Footer Signature -->
    <div class="hidden md:flex items-center justify-between pt-12 border-t border-gray-200/60 text-xs text-gray-500 font-serif italic">
      <span>Capri, 80076 (NA) · Italy</span>
      <span class="text-brand-gold not-italic uppercase tracking-[0.2em] font-sans text-[10px] font-semibold">Women-Owned · Est. 2010</span>
    </div>
  </div>

  <!-- Right Side: Narrative Editorial Scroll with Generous Whitespace -->
  <div class="md:w-7/12 lg:w-7/12 p-8 sm:p-12 lg:p-20 space-y-24 lg:space-y-32">
    
    <!-- Item 1: The B2B Evolution & Founders -->
    <div class="story-right-item gsap-reveal">
      <span class="text-brand-gold font-serif text-3xl mb-4 block italic">01. The Lineage</span>
      <h3 class="font-serif text-3xl lg:text-4xl text-brand-navy mb-6">
        From Nesea Capri to Elite Destination Management
      </h3>
      <p class="text-lg lg:text-xl leading-relaxed font-light text-gray-700 mb-6">
        Capri Destination Management Company is the dedicated Business-to-Business (B2B) spin-off from <strong class="text-brand-navy font-medium">Nesea Capri Tours & Events</strong>.
      </p>
      <p class="text-gray-500 leading-relaxed text-sm lg:text-base font-light mb-8">
        While Nesea established an infallible standard for island excursions, Capri DMC was forged specifically to serve luxury travel agencies, Virtuoso advisors, corporate incentive planners, and high-net-worth VIPs who require seamless logistical execution without intermediaries.
      </p>

      <!-- Founders Trio Card -->
      <div class="bg-brand-cream p-6 lg:p-8 rounded-sm border border-brand-gold/30">
        <span class="text-[10px] uppercase tracking-[0.25em] text-brand-gold font-semibold block mb-2">Founding Leadership</span>
        <h4 class="font-serif text-2xl text-brand-navy mb-4 font-normal">Giusy Perrotta · Melania Esposito · Roberta De Martino</h4>
        <p class="text-gray-600 font-light text-xs sm:text-sm leading-relaxed mb-6">
          A trio of vibrant, native Capresi whose intimate knowledge of every port, private villa, and cliffside trail on the island guarantees flawless, uncompromised execution for your travel clients.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-brand-navy/10 text-xs">
          {teamFounders.map((f) => (
            <div>
              <span class="font-semibold text-brand-navy block text-[11px]">{f.name}</span>
              <span class="text-brand-gold text-[9px] uppercase tracking-wider block mb-1">{f.role}</span>
              <span class="text-gray-500 text-[10px] font-light leading-snug block">{f.note}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Item 2: Authentic Capri Lifestyle Photography (Faraglioni from Private Terraces) -->
    <div class="story-right-item gsap-reveal img-zoom-container aspect-[4/5] bg-gray-100 w-full relative shadow-2xl">
      <img
        src="/images/capri/faraglioni-faraglioni-rocks.jpg"
        class="w-full h-full object-cover transition-all duration-1000"
        alt="Authentic Capri Faraglioni and Mediterranean Sea"
        loading="lazy"
      />
      <div class="absolute inset-0 border border-white/40 m-6 pointer-events-none z-10"></div>
      <div class="absolute bottom-10 left-10 right-10 bg-brand-navy/90 backdrop-blur-md p-6 z-20 text-white">
        <span class="text-[9px] uppercase tracking-[0.3em] text-brand-gold block mb-1 font-semibold">Editorial Note</span>
        <p class="font-serif text-xl italic text-white/95">"Your Roots in Capri — We open doors closed to standard tourism."</p>
      </div>
    </div>

    <!-- Item 3: Core Philosophy "From Capri for Capri" -->
    <div class="story-right-item gsap-reveal">
      <span class="text-brand-gold font-serif text-3xl mb-4 block italic">02. Authentic Heritage</span>
      <h3 class="font-serif text-3xl lg:text-4xl text-brand-navy mb-6">
        From Capri for Capri
      </h3>
      <p class="text-gray-600 leading-relaxed text-base lg:text-lg font-light mb-6">
        We are a <strong>Women-Owned business</strong> deeply intertwined with Capri's maritime guilds, historic private estate custodians, and municipal transit dispatchers.
      </p>
      <p class="text-gray-500 leading-relaxed text-sm lg:text-base font-light mb-8">
        We do not outsource to mainland operators or third-party call centers. When an advisor reaches out at 2:00 AM because a private jet arrived ahead of schedule in Naples, our island team is already dispatching private boat skippers and luxury Mercedes-Maybach chauffeurs directly on the ground.
      </p>
      
      <!-- Statistics Badges -->
      <div class="grid grid-cols-2 gap-6 pt-6 border-t border-gray-200">
        <div>
          <span class="font-serif text-4xl text-brand-gold block font-normal">24/7</span>
          <span class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Island Command Operations</span>
        </div>
        <div>
          <span class="font-serif text-4xl text-brand-navy block font-normal">100%</span>
          <span class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Capri Resident Team</span>
        </div>
      </div>
    </div>

    <!-- Item 4: Authentic Anacapri Faro Sunset Aperitivo -->
    <div class="story-right-item gsap-reveal img-zoom-container aspect-[16/10] bg-gray-100 w-full relative shadow-xl">
      <img
        src="/images/capri/anacapri-faro-aperitivo.jpg"
        class="w-full h-full object-cover"
        alt="Capri Faro Sunset Champagne Aperitivo"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/70 via-transparent to-transparent"></div>
      <div class="absolute bottom-6 left-6 text-white text-xs tracking-widest uppercase font-semibold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
        Punta Carena Faro · Private Sunset Gastronomy
      </div>
    </div>

    <!-- Item 5: The B2B Advisor Guarantee -->
    <div class="story-right-item gsap-reveal pb-16">
      <span class="text-brand-gold font-serif text-3xl mb-4 block italic">03. Advisor Partnership</span>
      <h3 class="font-serif text-3xl lg:text-4xl text-brand-navy mb-6">
        Protecting Your Client Reputation
      </h3>
      <p class="text-gray-600 leading-relaxed text-base font-light mb-8">
        Every luxury itinerary we execute is a direct reflection of your travel agency. We offer complete white-label service delivery, confidential client briefings, and zero-conflict commission protection.
      </p>
      <a
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-brand-navy text-white text-xs uppercase tracking-[0.2em] font-semibold hover:bg-brand-gold hover:text-brand-navy transition-all duration-300 shadow-md"
      >
        <span>Partner With Capri DMC</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- Pinned Story Scroll GSAP Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
      const mm = gsap.matchMedia();

      mm.add("(min-width: 768px)", () => {
        ScrollTrigger.create({
          trigger: "#story",
          start: "top top",
          end: "bottom bottom",
          pin: "#story-left",
          pinSpacing: false
        });
      });

      gsap.utils.toArray(".story-right-item").forEach((item) => {
        gsap.fromTo(
          item,
          { y: 45, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 1.1,
            ease: "power3.out",
            scrollTrigger: {
              trigger: item,
              start: "top 85%",
              toggleActions: "play none none reverse"
            }
          }
        );
      });
    }
  });
</script>
