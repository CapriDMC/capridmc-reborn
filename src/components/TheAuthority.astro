---
// Cartier-Inspired Editorial Storytelling: The Maison & Lineage
const teamFounders = [
  {
    name: "Giusy Perrotta",
    role: "Co-Founder & Director of Operations",
    note: "Native Caprese with 15+ years orchestrating maritime logistics and VIP advisor relations."
  },
  {
    name: "Melania Esposito",
    role: "Co-Founder & Head of Event Production",
    note: "Specialist in private historic villa buyouts, weddings, and Jewish milestone celebrations."
  },
  {
    name: "Roberta De Martino",
    role: "Co-Founder & Lead Cultural Curator",
    note: "Licensed art historian leading exclusive cultural itineraries and high-level island protocol."
  }
];

const emailContact = "mailto:partnerships@capridmc.com?subject=Partnership%20Capri%20DMC";
---

<section id="story" class="relative cartier-layer-solid-white text-brand-navy py-28 lg:py-36 px-6 lg:px-16 overflow-hidden">
  <div class="max-w-7xl mx-auto space-y-28 lg:space-y-36">

    <!-- Section Header (Cartier Minimalism & Negative Space) -->
    <div class="max-w-3xl mx-auto text-center space-y-4 story-header gsap-reveal">
      <div class="inline-flex items-center justify-center gap-3">
        <span class="w-6 h-[1px] bg-brand-gold"></span>
        <span class="text-brand-gold uppercase tracking-[0.32em] text-[10px] sm:text-xs font-semibold">
          The Local Authority · Est. 2010
        </span>
        <span class="w-6 h-[1px] bg-brand-gold"></span>
      </div>

      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-navy font-light leading-[1.08]">
        Your Team in Capri. <br />
        <span class="italic text-brand-gold font-light">The best partner to plan your trip.</span>
      </h2>

      <p class="text-gray-600 font-light text-base lg:text-lg max-w-2xl mx-auto leading-relaxed pt-2">
        Since 2010, our founders have woven their lives into the island's fabric. We are the direct bridge between global luxury travel designers and the authentic heartbeat of Capri.
      </p>

      <div class="pt-2">
        <span class="inline-block px-3 py-1 bg-brand-navy/5 text-brand-navy text-[10px] uppercase tracking-[0.2em] font-medium border border-brand-navy/15">
          Elite Spin-Off from Nesea Capri Tours & Events
        </span>
      </div>
    </div>

    <!-- 50/50 Alternating Row 1: The Lineage & Faraglioni Photography -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      
      <!-- Text Column (6 cols) -->
      <div class="lg:col-span-6 space-y-6 story-reveal-item gsap-reveal">
        <div class="space-y-2">
          <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">01 / The Lineage</span>
          <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal leading-tight">
            From Nesea Capri to Elite Destination Management
          </h3>
        </div>

        <p class="text-gray-700 font-light text-base lg:text-lg leading-relaxed">
          Capri Destination Management Company is the dedicated Business-to-Business (B2B) spin-off from <strong class="text-brand-navy font-medium">Nesea Capri Tours & Events</strong>.
        </p>

        <p class="text-gray-500 font-light text-sm sm:text-base leading-relaxed">
          While Nesea established an infallible standard for island excursions, Capri DMC was forged specifically to serve luxury travel agencies, Virtuoso advisors, corporate incentive planners, and high-net-worth VIPs who require seamless logistical execution without intermediaries.
        </p>

        <div class="pt-4 border-t border-gray-200">
          <div class="grid grid-cols-2 gap-6">
            <div>
              <span class="font-serif text-3xl sm:text-4xl text-brand-gold block font-light">Est. 2010</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-500 font-medium">Island Lineage</span>
            </div>
            <div>
              <span class="font-serif text-3xl sm:text-4xl text-brand-navy block font-light">100%</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-500 font-medium">Resident Capresi</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Image Column (6 cols) -->
      <div class="lg:col-span-6 story-reveal-item gsap-reveal">
        <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden">
          <picture class="w-full h-full block">
            <source srcset="/images/capri/capri-faraglioni-rocks.webp" type="image/webp" />
            <img
              src="/images/capri/capri-faraglioni-rocks.jpg"
              alt="Authentic Capri Faraglioni and Mediterranean Sea"
              width="1600"
              height="1200"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-[#07142E]/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white text-xs font-serif italic">
            "Your Roots in Capri — We open doors closed to standard tourism."
          </div>
        </div>
      </div>

    </div>

    <!-- 50/50 Alternating Row 2: Faro Sunset Image (Left) & Founders Trio (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      
      <!-- Image Column (6 cols, Inverted Left) -->
      <div class="lg:col-span-6 order-2 lg:order-1 story-reveal-item gsap-reveal">
        <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden">
          <picture class="w-full h-full block">
            <source srcset="/images/capri/anacapri-faro-sunset-aperitivo.webp" type="image/webp" />
            <img
              src="/images/capri/anacapri-faro-sunset-aperitivo.jpg"
              alt="Capri Faro Sunset Champagne Aperitivo"
              width="1600"
              height="1200"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-[#07142E]/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white text-[11px] uppercase tracking-widest font-medium">
            Punta Carena Faro · Private Sunset Gastronomy
          </div>
        </div>
      </div>

      <!-- Text Column (6 cols, Inverted Right) -->
      <div class="lg:col-span-6 order-1 lg:order-2 space-y-6 story-reveal-item gsap-reveal">
        <div class="space-y-2">
          <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">02 / The Leadership</span>
          <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal leading-tight">
            From Capri for Capri
          </h3>
        </div>

        <p class="text-gray-600 font-light text-base leading-relaxed">
          We are a <strong>Women-Owned business</strong> deeply intertwined with Capri's maritime guilds, historic private estate custodians, and municipal transit dispatchers.
        </p>

        <!-- Founders Trio Grid (Clean, Flat, Minimalist) -->
        <div class="pt-4 border-t border-gray-200 space-y-4">
          <span class="text-[10px] uppercase tracking-[0.25em] text-brand-gold font-semibold block">
            Founding Leadership
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {teamFounders.map((founder) => (
              <div class="space-y-1">
                <span class="font-serif text-lg text-brand-navy block leading-snug">
                  {founder.name}
                </span>
                <span class="text-[9px] uppercase tracking-wider text-brand-gold font-medium block">
                  {founder.role}
                </span>
                <p class="text-[11px] text-gray-500 font-light leading-relaxed">
                  {founder.note}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-4">
          <a
            href={emailContact}
            class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-brand-navy hover:text-brand-gold transition-colors pb-1 border-b border-brand-navy/30 hover:border-brand-gold"
          >
            <span>Inquire Advisor Partnership</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- GSAP ScrollTrigger for The Authority -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
      gsap.fromTo(".story-header",
        { y: 30, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.9,
          ease: "power3.out",
          force3D: true,
          scrollTrigger: {
            trigger: ".story-header",
            start: "top 85%",
            once: true
          }
        }
      );

      gsap.utils.toArray(".story-reveal-item").forEach((el) => {
        gsap.fromTo(el,
          { y: 35, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.8,
            ease: "power2.out",
            force3D: true,
            scrollTrigger: {
              trigger: el,
              start: "top 80%",
              once: true
            }
          }
        );
      });
    }
  });
</script>
