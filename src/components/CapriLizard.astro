---
// Capri DMC - Faraglioni Azure Lizard (Podarcis siculus coeruleus)
// Ultra-HD Articulated Living Mascot with Distinct Crawling Kinematics & Delicate Sibilant Tongue
---

<div
  id="capri-lizard-container"
  class="fixed right-2 sm:right-3 md:right-4 lg:right-6 top-0 z-40 pointer-events-none select-none transition-opacity duration-700 opacity-0 w-20 h-44 sm:w-24 sm:h-52 md:w-28 md:h-60 lg:w-32 lg:h-64"
  aria-hidden="true"
>
  <canvas
    id="capri-lizard-canvas"
    class="w-full h-full block"
  ></canvas>
</div>

<script is:inline>
  (() => {
    // Respect reduced motion preference
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const container = document.getElementById("capri-lizard-container");
    const canvas = document.getElementById("capri-lizard-canvas");
    if (!container || !canvas) return;

    const ctx = canvas.getContext("2d");
    const dpr = Math.min(window.devicePixelRatio || 2, 3);

    // Anatomical Rig Specification (Derived from 478 x 1130 px HD render)
    const rig = {
      W: 478,
      H: 1130,
      fl: { x: 40, y: 840, w: 190, h: 195, pivotX: 140, pivotY: 85 },
      fr: { x: 248, y: 840, w: 190, h: 195, pivotX: 50, pivotY: 85 },
      rl: { x: 10, y: 510, w: 225, h: 225, pivotX: 175, pivotY: 140 },
      rr: { x: 240, y: 510, w: 225, h: 225, pivotX: 50, pivotY: 140 },
    };

    // Component Images
    const bodyImg = new Image();
    const flImg = new Image();
    const frImg = new Image();
    const rlImg = new Image();
    const rrImg = new Image();

    let loadedCount = 0;
    let isRigReady = false;

    function onComponentLoad() {
      loadedCount++;
      if (loadedCount === 5) {
        isRigReady = true;
        resizeCanvas();
        init();
      }
    }

    bodyImg.onload = onComponentLoad; bodyImg.src = "/images/lizard-body.png";
    flImg.onload = onComponentLoad;   flImg.src = "/images/lizard-leg-fl.png";
    frImg.onload = onComponentLoad;   frImg.src = "/images/lizard-leg-fr.png";
    rlImg.onload = onComponentLoad;   rlImg.src = "/images/lizard-leg-rl.png";
    rrImg.onload = onComponentLoad;   rrImg.src = "/images/lizard-leg-rr.png";

    // Dynamic State
    let cssW = 0;
    let cssH = 0;

    let scrollY = window.scrollY || 0;
    let lastScrollY = scrollY;
    let targetY = 100;
    let currentY = 100;

    let walkPhase = 0;
    let walkSpeed = 0;
    let currentSwing = 0;

    // Joint rotation angles (radians)
    let flAngle = 0;
    let frAngle = 0;
    let rlAngle = 0;
    let rrAngle = 0;

    let headAngle = 0;
    let targetHeadAngle = 0;
    let tongueProgress = 0;
    let tongueVibe = 0;

    let isIdle = false;
    let idleTimer = null;
    let tongueAnimTimer = null;
    let periodicIdleTimer = null;
    let isInitialized = false;

    function resizeCanvas() {
      cssW = container.offsetWidth || 100;
      cssH = container.offsetHeight || 220;

      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      ctx.resetTransform();
      ctx.scale(dpr, dpr);
    }

    function getTravelBounds() {
      const winHeight = window.innerHeight;
      const lizardH = cssH || 200;
      const minY = 90; // Below sticky navigation
      const maxY = Math.max(minY + 60, winHeight - lizardH - 24);
      return { minY, maxY };
    }

    function calculateTargetY() {
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const maxScroll = Math.max(1, docHeight - winHeight);
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));
      const { minY, maxY } = getTravelBounds();
      return minY + progress * (maxY - minY);
    }

    function init() {
      scrollY = window.scrollY || 0;
      lastScrollY = scrollY;
      currentY = calculateTargetY();
      targetY = currentY;
      container.style.transform = `translate3d(0, ${currentY}px, 0)`;
      container.classList.remove("opacity-0");
      container.classList.add("opacity-100");
      isInitialized = true;
      scheduleIdleCheck();
      requestAnimationFrame(renderLoop);
    }

    // Idle State Choreography: Inquisitive Head Turn + Delicate, Fast Sibilant Tongue
    function triggerIdleState() {
      isIdle = true;
      targetHeadAngle = -0.42; // Incurvamento visibile del capo (~24°) verso i contenuti a sinistra

      if (tongueAnimTimer) clearTimeout(tongueAnimTimer);
      tongueAnimTimer = setTimeout(() => {
        if (!isIdle) return;
        animateTongueFlick();
      }, 180);

      if (periodicIdleTimer) clearInterval(periodicIdleTimer);
      periodicIdleTimer = setInterval(() => {
        if (isIdle) {
          animateTongueFlick();
        }
      }, 3800);
    }

    function animateTongueFlick() {
      const startTime = performance.now();
      const duration = 480; // Rapido, scattante e autentico sibilo da lucertola (3 micro-vibrazioni)

      function stepTongue(now) {
        if (!isIdle) {
          tongueProgress = 0;
          return;
        }

        const elapsed = now - startTime;
        const t = Math.min(1, elapsed / duration);

        if (t < 0.20) {
          // Scatto rapido verso l'esterno (~95ms)
          tongueProgress = Math.sin((t / 0.20) * (Math.PI / 2));
          tongueVibe = Math.sin(t * 80) * 0.06;
        } else if (t < 0.72) {
          // 3 rapidi micro-tremolii di captazione olfattiva nell'aria
          const flutterT = (t - 0.20) / 0.52;
          tongueProgress = 0.88 + Math.sin(flutterT * Math.PI * 6) * 0.12;
          tongueVibe = Math.sin(flutterT * Math.PI * 10) * 0.08;
        } else {
          // Rientro agile nel muso (~135ms)
          const retractT = (t - 0.72) / 0.28;
          tongueProgress = (1 - retractT) * 0.88;
          tongueVibe = 0;
        }

        if (t < 1 && isIdle) {
          requestAnimationFrame(stepTongue);
        } else {
          tongueProgress = 0;
        }
      }

      requestAnimationFrame(stepTongue);
    }

    function exitIdleState() {
      if (!isIdle) return;
      isIdle = false;
      targetHeadAngle = 0; // Testa torna dritta verso il basso
      tongueProgress = 0;
      tongueVibe = 0;

      if (tongueAnimTimer) clearTimeout(tongueAnimTimer);
      if (periodicIdleTimer) clearInterval(periodicIdleTimer);
    }

    function scheduleIdleCheck() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        triggerIdleState();
      }, 400); // 400ms debounce
    }

    // Scroll Listener
    window.addEventListener(
      "scroll",
      () => {
        scrollY = window.scrollY || 0;
        targetY = calculateTargetY();

        const delta = Math.abs(scrollY - lastScrollY);
        walkSpeed = Math.min(delta * 0.12, 2.2);

        if (isIdle) {
          exitIdleState();
        }

        scheduleIdleCheck();
      },
      { passive: true }
    );

    window.addEventListener(
      "resize",
      () => {
        resizeCanvas();
        targetY = calculateTargetY();
      },
      { passive: true }
    );

    // 60FPS Kinematics Loop
    function renderLoop() {
      if (isInitialized && isRigReady) {
        // 1. Smooth vertical descent lerp
        const diff = targetY - currentY;
        currentY += diff * 0.12;
        container.style.transform = `translate3d(0, ${currentY}px, 0)`;

        // 2. Head angle lerp
        headAngle += (targetHeadAngle - headAngle) * 0.14;

        // 3. Articulated Locomotion (Alternating Diagonal Trotting Gait)
        const scrollDelta = Math.abs(scrollY - lastScrollY);
        lastScrollY = scrollY;

        if (!isIdle && (scrollDelta > 0.3 || Math.abs(diff) > 0.6)) {
          walkPhase += Math.max(scrollDelta * 0.055, 0.09);
          // Target swing amplitude expands with speed (up to 26 degrees)
          const targetSwing = Math.min(0.25 + walkSpeed * 0.15, 0.45);
          currentSwing += (targetSwing - currentSwing) * 0.22;

          // Distinct stepping: FL and RR are in sync, FR and RL are 180deg out of phase
          const targetFl = Math.sin(walkPhase) * currentSwing;
          const targetRr = Math.sin(walkPhase) * currentSwing;
          const targetFr = Math.sin(walkPhase + Math.PI) * currentSwing;
          const targetRl = Math.sin(walkPhase + Math.PI) * currentSwing;

          flAngle += (targetFl - flAngle) * 0.28;
          rrAngle += (targetRr - rrAngle) * 0.28;
          frAngle += (targetFr - frAngle) * 0.28;
          rlAngle += (targetRl - rlAngle) * 0.28;
        } else {
          // Smooth damping to elegant resting grip
          walkSpeed *= 0.85;
          currentSwing *= 0.85;

          flAngle += (0.04 - flAngle) * 0.12;
          rrAngle += (-0.04 - rrAngle) * 0.12;
          frAngle += (-0.04 - frAngle) * 0.12;
          rlAngle += (0.04 - rlAngle) * 0.12;
        }

        // 4. Render lizard frame
        drawLizardFrame();
      }

      requestAnimationFrame(renderLoop);
    }

    function drawLizardFrame() {
      ctx.clearRect(0, 0, cssW, cssH);

      const destH = cssH * 0.74;
      const destW = destH * (rig.W / rig.H);
      const scale = destH / rig.H;
      const originX = cssW / 2;
      const originY = 8;

      // 1. Natural Soft Drop Shadow
      ctx.save();
      ctx.translate(3, 7);
      ctx.globalAlpha = 0.28;
      ctx.filter = "blur(5px) brightness(0)";
      drawLizardLayers(originX, originY, destW, destH, scale, false);
      ctx.restore();

      // 2. Main Realistic Articulated Lizard
      ctx.save();
      drawLizardLayers(originX, originY, destW, destH, scale, true);
      ctx.restore();
    }

    function drawLizardLayers(originX, originY, destW, destH, scale, withTongue) {
      // 1. Draw 4 articulated legs under the body
      function drawLeg(img, bbox, angle) {
        ctx.save();
        const pivotGlobalX = originX + (bbox.x + bbox.pivotX - rig.W / 2) * scale;
        const pivotGlobalY = originY + (bbox.y + bbox.pivotY) * scale;

        ctx.translate(pivotGlobalX, pivotGlobalY);
        ctx.rotate(angle);

        // Step flexion & extension (reaches forward down, pushes back up)
        const strideStretch = 1 + Math.sin(angle) * 0.12;
        ctx.scale(scale, scale * strideStretch);

        ctx.drawImage(img, -bbox.pivotX, -bbox.pivotY);
        ctx.restore();
      }

      drawLeg(flImg, rig.fl, flAngle);
      drawLeg(frImg, rig.fr, frAngle);
      drawLeg(rlImg, rig.rl, rlAngle);
      drawLeg(rrImg, rig.rr, rrAngle);

      // 2. Draw central body on top (with spine/tail undulation & head turn)
      renderDeformedBody(originX, originY, destW, destH, scale);

      // 3. Delicate, Whisper-Thin Realistic Forked Tongue
      if (withTongue && tongueProgress > 0.03) {
        const headOffset = (headAngle !== 0) ? headAngle * 36 : 0;
        const snoutX = originX + headOffset;
        const snoutY = originY + destH - 1;
        renderRealisticTongue(snoutX, snoutY);
      }
    }

    function renderDeformedBody(originX, originY, destW, destH, scale) {
      const numStrips = 80;
      const sliceH_src = rig.H / numStrips;
      const sliceH_dest = destH / numStrips;
      const startX = originX - destW / 2;

      for (let i = 0; i < numStrips; i++) {
        const normY = i / numStrips; // 0 (tail tip) to 1 (snout)
        const sy = i * sliceH_src;
        const dy = originY + i * sliceH_dest;

        // Spinal wave rhythmically synchronized with locomotion
        let wave = 0;
        if (!isIdle || walkSpeed > 0.05) {
          wave = Math.sin(walkPhase + normY * 4.5) * (1 - normY) * 6 * Math.min(1, walkSpeed + 0.3);
        }

        // Head flexion towards left content on idle
        let headOffset = 0;
        if (headAngle !== 0 && normY > 0.80) {
          const t = (normY - 0.80) / 0.20;
          headOffset = headAngle * 36 * t * t;
        }

        const dx = startX + wave + headOffset;

        ctx.drawImage(
          bodyImg,
          0, sy, rig.W, sliceH_src,
          dx, dy, destW, sliceH_dest + 0.35 // Overlap prevents sub-pixel aliasing
        );
      }
    }

    function renderRealisticTongue(snoutX, snoutY) {
      // Proportional, slender & vivid: ~28px reach, delicate 1.6px shaft & 1.1px tines
      const reach = 28 * tongueProgress;
      const spread = 6.5 * tongueProgress;

      ctx.save();
      ctx.translate(snoutX, snoutY);
      // Tangent to head curve points to the left (-headAngle is positive clockwise from down towards left)
      ctx.rotate(-headAngle * 0.95 + tongueVibe);

      // Vivid luminous ruby & golden sheen (high-contrast on both dark and light backgrounds)
      const tongueGrad = ctx.createLinearGradient(0, 0, 0, reach);
      tongueGrad.addColorStop(0, "#BE123C");    // Vivid ruby vermilion
      tongueGrad.addColorStop(0.55, "#F43F5E"); // Luminous coral crimson
      tongueGrad.addColorStop(0.85, "#FBBF24"); // Amber gold
      tongueGrad.addColorStop(1, "#FFFFFF");    // Brilliant light-catching tip

      ctx.shadowColor = "#F43F5E";
      ctx.shadowBlur = 4;

      // 1. Slender main shaft (1.6px)
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(0, reach * 0.65);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 1.6;
      ctx.lineCap = "round";
      ctx.stroke();

      // 2. Left tine (delicate, acute curve 1.1px)
      ctx.beginPath();
      ctx.moveTo(0, reach * 0.65);
      ctx.quadraticCurveTo(-spread * 0.35, reach * 0.82, -spread, reach);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 1.1;
      ctx.lineCap = "round";
      ctx.stroke();

      // 3. Right tine
      ctx.beginPath();
      ctx.moveTo(0, reach * 0.65);
      ctx.quadraticCurveTo(spread * 0.35, reach * 0.82, spread, reach);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 1.1;
      ctx.lineCap = "round";
      ctx.stroke();

      // 4. Subtle micro glint at tine tips
      ctx.beginPath();
      ctx.arc(-spread, reach, 0.7, 0, Math.PI * 2);
      ctx.arc(spread, reach, 0.7, 0, Math.PI * 2);
      ctx.fillStyle = "#FFFFFF";
      ctx.fill();

      ctx.restore();
    }
  })();
</script>
