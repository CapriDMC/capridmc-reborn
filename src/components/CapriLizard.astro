---
// Capri DMC - Faraglioni Azure Lizard (Podarcis siculus coeruleus)
// Ultra-HD Realistic Living Mascot & Cinematic Kinematics Engine
---

<div
  id="capri-lizard-container"
  class="fixed right-2 sm:right-3 md:right-4 lg:right-6 top-0 z-40 pointer-events-none select-none transition-opacity duration-700 opacity-0 w-20 h-44 sm:w-24 sm:h-52 md:w-28 md:h-60 lg:w-32 lg:h-64"
  aria-hidden="true"
>
  <canvas
    id="capri-lizard-canvas"
    class="w-full h-full block"
  ></canvas>
</div>

<script is:inline>
  (() => {
    // Respect reduced motion preference
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const container = document.getElementById("capri-lizard-container");
    const canvas = document.getElementById("capri-lizard-canvas");
    if (!container || !canvas) return;

    const ctx = canvas.getContext("2d");
    const dpr = Math.min(window.devicePixelRatio || 2, 3);

    // State Variables
    let img = new Image();
    let isImgLoaded = false;
    let cssW = 0;
    let cssH = 0;

    let scrollY = window.scrollY || 0;
    let lastScrollY = scrollY;
    let targetY = 100;
    let currentY = 100;

    let walkPhase = 0;
    let walkSpeed = 0;
    let headAngle = 0;
    let targetHeadAngle = 0;
    let tongueProgress = 0;
    let tongueVibe = 0;

    let isIdle = false;
    let idleTimer = null;
    let tongueAnimTimer = null;
    let periodicIdleTimer = null;
    let isInitialized = false;

    // Load HD photorealistic Capri blue lizard asset
    img.src = "/images/capri-blue-lizard-hd.png";
    img.onload = () => {
      isImgLoaded = true;
      resizeCanvas();
      init();
    };

    function resizeCanvas() {
      cssW = container.offsetWidth || 100;
      cssH = container.offsetHeight || 220;

      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      ctx.resetTransform();
      ctx.scale(dpr, dpr);
    }

    // Vertical boundary calculation
    function getTravelBounds() {
      const winHeight = window.innerHeight;
      const lizardH = cssH || 200;
      const minY = 90; // Cleanly below the sticky navigation bar
      const maxY = Math.max(minY + 60, winHeight - lizardH - 24);
      return { minY, maxY };
    }

    function calculateTargetY() {
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const maxScroll = Math.max(1, docHeight - winHeight);
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));
      const { minY, maxY } = getTravelBounds();
      return minY + progress * (maxY - minY);
    }

    function init() {
      scrollY = window.scrollY || 0;
      lastScrollY = scrollY;
      currentY = calculateTargetY();
      targetY = currentY;
      container.style.transform = `translate3d(0, ${currentY}px, 0)`;
      container.classList.remove("opacity-0");
      container.classList.add("opacity-100");
      isInitialized = true;
      scheduleIdleCheck();
      requestAnimationFrame(renderLoop);
    }

    // Idle State Choreography: Inquisitive Head Turn + Highly Visible Forked Tongue
    function triggerIdleState() {
      isIdle = true;
      targetHeadAngle = -0.38; // Tilt head towards the page content on the left (~22deg)

      // Start tongue sequence after head has turned inquisitively
      if (tongueAnimTimer) clearTimeout(tongueAnimTimer);
      tongueAnimTimer = setTimeout(() => {
        if (!isIdle) return;
        animateTongueFlick();
      }, 240);

      // Schedule periodic air-tasting while staying idle
      if (periodicIdleTimer) clearInterval(periodicIdleTimer);
      periodicIdleTimer = setInterval(() => {
        if (isIdle && Math.abs(headAngle - targetHeadAngle) < 0.05) {
          animateTongueFlick();
        }
      }, 4500);
    }

    function animateTongueFlick() {
      const startTime = performance.now();
      const duration = 750; // Extended duration for high visibility and authentic sibilance

      function stepTongue(now) {
        if (!isIdle) {
          tongueProgress = 0;
          return;
        }

        const elapsed = now - startTime;
        const t = Math.min(1, elapsed / duration);

        if (t < 0.18) {
          // Swift dart outward (0 to 1 in ~135ms)
          tongueProgress = Math.sin((t / 0.18) * (Math.PI / 2));
          tongueVibe = Math.sin(t * 60) * 0.08;
        } else if (t < 0.72) {
          // Sibilant air-tasting vibration / 4 flutter cycles
          const flutterT = (t - 0.18) / 0.54;
          tongueProgress = 0.88 + Math.sin(flutterT * Math.PI * 8) * 0.14;
          tongueVibe = Math.sin(flutterT * Math.PI * 12) * 0.15;
        } else {
          // Smooth retraction back into snout
          const retractT = (t - 0.72) / 0.28;
          tongueProgress = (1 - retractT) * 0.88;
          tongueVibe = 0;
        }

        if (t < 1 && isIdle) {
          requestAnimationFrame(stepTongue);
        } else {
          tongueProgress = 0;
        }
      }

      requestAnimationFrame(stepTongue);
    }

    function exitIdleState() {
      if (!isIdle) return;
      isIdle = false;
      targetHeadAngle = 0; // Realign head straight downwards
      tongueProgress = 0;
      tongueVibe = 0;

      if (tongueAnimTimer) clearTimeout(tongueAnimTimer);
      if (periodicIdleTimer) clearInterval(periodicIdleTimer);
    }

    function scheduleIdleCheck() {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        triggerIdleState();
      }, 450); // 450ms debounce
    }

    // Scroll Listener (Passive & 60FPS)
    window.addEventListener(
      "scroll",
      () => {
        scrollY = window.scrollY || 0;
        targetY = calculateTargetY();

        const delta = Math.abs(scrollY - lastScrollY);
        walkSpeed = Math.min(delta * 0.08, 1.8);

        if (isIdle) {
          exitIdleState();
        }

        scheduleIdleCheck();
      },
      { passive: true }
    );

    // Resize Listener
    window.addEventListener(
      "resize",
      () => {
        resizeCanvas();
        targetY = calculateTargetY();
      },
      { passive: true }
    );

    // Main 60FPS Kinematics & Rendering Loop
    function renderLoop() {
      if (isInitialized && isImgLoaded) {
        // 1. Smooth vertical travel lerp
        const diff = targetY - currentY;
        currentY += diff * 0.12;
        container.style.transform = `translate3d(0, ${currentY}px, 0)`;

        // 2. Head angle lerp
        headAngle += (targetHeadAngle - headAngle) * 0.14;

        // 3. Walk cycle & spine wave integration
        const scrollDelta = Math.abs(scrollY - lastScrollY);
        lastScrollY = scrollY;

        if (!isIdle && (scrollDelta > 0.4 || Math.abs(diff) > 0.8)) {
          walkPhase += Math.max(scrollDelta * 0.045, 0.08);
        } else {
          // Smoothly damp walkPhase to resting pose
          walkSpeed *= 0.85;
        }

        // 4. Draw realistic lizard frame
        drawLizardFrame();
      }

      requestAnimationFrame(renderLoop);
    }

    function drawLizardFrame() {
      ctx.clearRect(0, 0, cssW, cssH);

      const imgW = img.width;
      const imgH = img.height;

      // Fit lizard proportionally inside canvas with generous room for tongue extension
      const destH = cssH * 0.74;
      const destW = destH * (imgW / imgH);
      const startX = (cssW - destW) / 2;
      const startY = 8;

      // 1. Natural Soft Drop Shadow
      ctx.save();
      ctx.translate(3, 7);
      renderDeformedLizard(ctx, img, imgW, imgH, startX, startY, destW, destH, true);
      ctx.restore();

      // 2. Soft Ambient Gold Rim Light
      ctx.save();
      ctx.shadowColor = "rgba(212, 175, 55, 0.4)";
      ctx.shadowBlur = 6;
      renderDeformedLizard(ctx, img, imgW, imgH, startX, startY, destW, destH, false, 0.35);
      ctx.restore();

      // 3. Main Realistic HD Body (Continuous Axial Undulation)
      ctx.save();
      renderDeformedLizard(ctx, img, imgW, imgH, startX, startY, destW, destH, false, 1.0);
      ctx.restore();

      // 4. Luminous Hissing Forked Tongue
      if (tongueProgress > 0.03) {
        renderForkedTongue(ctx, startX, startY, destW, destH);
      }
    }

    function renderDeformedLizard(ctx, image, srcW, srcH, destX, destY, destW, destH, isShadow, opacity = 1.0) {
      const numStrips = 120; // 120 horizontal strips for continuous, seamless curvature
      const sliceH_src = srcH / numStrips;
      const sliceH_dest = destH / numStrips;

      ctx.save();
      if (isShadow) {
        ctx.globalAlpha = 0.32;
        ctx.filter = "blur(4px) brightness(0)";
      } else if (opacity < 1.0) {
        ctx.globalAlpha = opacity;
      }

      for (let i = 0; i < numStrips; i++) {
        const normY = i / numStrips; // 0 (tail tip) to 1 (snout)
        const sy = i * sliceH_src;
        const dy = destY + i * sliceH_dest;

        // Herpetological S-curve undulation: tail lashes gracefully, chest sways with gait
        let wave = 0;
        if (!isIdle || walkSpeed > 0.05) {
          const tailFactor = Math.pow(1 - normY, 1.35);
          const chestFactor = Math.sin(normY * Math.PI) * 0.45;
          const amplitude = (15 * tailFactor + 6 * chestFactor) * Math.min(1, (walkSpeed + 0.3));
          wave = Math.sin(walkPhase + normY * 5.2) * amplitude;
        }

        // Seamless anatomical head flexion (smooth cubic curve from neck normY=0.78 to snout normY=1.0)
        let headOffset = 0;
        if (headAngle !== 0 && normY > 0.78) {
          const headFactor = (normY - 0.78) / 0.22;
          const smoothT = headFactor * headFactor * (3 - 2 * headFactor);
          headOffset = headAngle * 34 * smoothT;
        }

        const dx = destX + wave + headOffset;

        ctx.drawImage(
          image,
          0, sy, srcW, sliceH_src,
          dx, dy, destW, sliceH_dest + 0.35 // Overlap avoids micro-seam aliasing
        );
      }

      ctx.restore();
    }

    function renderForkedTongue(ctx, destX, startY, destW, destH) {
      // Snout tip anchor position
      const headOffset = (headAngle !== 0) ? headAngle * 34 : 0;
      const snoutX = destX + (destW / 2) + headOffset;
      const snoutY = startY + destH - 4;

      const reach = 54 * tongueProgress;
      const spread = 15 * tongueProgress;

      ctx.save();
      ctx.translate(snoutX, snoutY);

      // Align tongue with the head's rotation plus micro-vibrations
      ctx.rotate(headAngle * 0.95 + tongueVibe);

      // High-Contrast Luminous Carmine & Golden Gradient (Unmistakable on any background)
      const tongueGrad = ctx.createLinearGradient(0, 0, 0, reach);
      tongueGrad.addColorStop(0, "#991B1B");    // Deep ruby red base
      tongueGrad.addColorStop(0.35, "#DC2626"); // Vivid vermilion
      tongueGrad.addColorStop(0.72, "#F59E0B"); // Luminous amber gold
      tongueGrad.addColorStop(1, "#FFFBEB");    // Brilliant light-reflecting tips

      // Luminous glow for maximum contrast
      ctx.shadowColor = "#F59E0B";
      ctx.shadowBlur = 12;

      // 1. Main Tongue Shaft
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(0, reach * 0.68);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 3.2;
      ctx.lineCap = "round";
      ctx.stroke();

      // 2. Left Forked Tine (sinuous, sharp curve)
      ctx.beginPath();
      ctx.moveTo(0, reach * 0.68);
      ctx.quadraticCurveTo(-spread * 0.35, reach * 0.84, -spread, reach);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 2.2;
      ctx.lineCap = "round";
      ctx.stroke();

      // 3. Right Forked Tine
      ctx.beginPath();
      ctx.moveTo(0, reach * 0.68);
      ctx.quadraticCurveTo(spread * 0.35, reach * 0.84, spread, reach);
      ctx.strokeStyle = tongueGrad;
      ctx.lineWidth = 2.2;
      ctx.lineCap = "round";
      ctx.stroke();

      // 4. Delicate brilliant jewel glint on tips
      ctx.beginPath();
      ctx.arc(-spread, reach, 1.4, 0, Math.PI * 2);
      ctx.arc(spread, reach, 1.4, 0, Math.PI * 2);
      ctx.fillStyle = "#FFFFFF";
      ctx.fill();

      ctx.restore();
    }
  })();
</script>
