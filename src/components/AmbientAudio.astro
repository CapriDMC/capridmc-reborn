---
/**
 * AmbientAudio.astro — Suono Naturale delle Onde del Mare (Capri Mediterranean Waves)
 * Audio naturale delle onde del mare autentico, semplice e rilassante.
 * Avvio automatico all'apertura della pagina con gestione conforme dell'autoplay policy dei browser.
 */
---

<!-- Elemento Audio Nativo per Riproduzione Naturale in Loop -->
<audio id="ambient-sea-audio" preload="auto" loop playsinline>
  <source src="/audio/capri-sea-waves.m4a" type="audio/mp4" />
  <source src="/audio/capri-sea-waves.mp3" type="audio/mpeg" />
</audio>

<div
  id="ambient-audio-container"
  class="fixed bottom-5 right-5 md:bottom-6 md:right-6 z-40 flex items-center"
>
  <button
    id="ambient-audio-toggle"
    type="button"
    aria-label="Attiva o disattiva il suono naturale delle onde del mare di Capri"
    class="group flex items-center gap-3 px-3.5 py-2 rounded-full bg-brand-navy/95 hover:bg-brand-navy border border-brand-gold/40 hover:border-brand-gold text-white shadow-2xl backdrop-blur-md transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-gold/50"
  >
    <!-- Icona Onde / Equalizzatore sonoro dorato -->
    <div class="relative flex items-center justify-center w-5 h-5 text-brand-gold">
      <span class="sr-only">Stato audio</span>
      <!-- Barre animate quando in riproduzione -->
      <div id="audio-eq-bars" class="flex items-end gap-[2px] h-3.5 opacity-90 group-hover:opacity-100 transition-opacity">
        <span class="eq-bar w-[2.5px] h-2 bg-brand-gold rounded-full"></span>
        <span class="eq-bar w-[2.5px] h-3.5 bg-brand-gold rounded-full"></span>
        <span class="eq-bar w-[2.5px] h-1.5 bg-brand-gold rounded-full"></span>
      </div>
      <!-- Icona Muto (quando in pausa) -->
      <svg id="audio-mute-icon" class="w-4 h-4 hidden text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
      </svg>
    </div>

    <!-- Etichetta descrittiva -->
    <div class="flex flex-col text-left">
      <span class="text-[9px] uppercase tracking-[0.2em] text-brand-gold font-mono font-semibold leading-tight">
        Onde del Mare
      </span>
      <span id="audio-status-label" class="text-[10px] text-white/70 font-light leading-tight">
        In ascolto
      </span>
    </div>

    <!-- Indicatore live -->
    <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-sm shadow-emerald-400/50" id="audio-live-dot"></div>
  </button>
</div>

<style>
  .eq-bar {
    transform-origin: bottom;
    animation: eqBounce 1.4s ease-in-out infinite alternate;
  }
  .eq-bar:nth-child(1) {
    animation-delay: 0.1s;
    animation-duration: 1.2s;
  }
  .eq-bar:nth-child(2) {
    animation-delay: 0.4s;
    animation-duration: 1.6s;
  }
  .eq-bar:nth-child(3) {
    animation-delay: 0.2s;
    animation-duration: 1.3s;
  }

  .audio-paused .eq-bar {
    animation: none;
    height: 3px !important;
    opacity: 0.4;
  }

  @keyframes eqBounce {
    0% {
      height: 2px;
    }
    50% {
      height: 14px;
    }
    100% {
      height: 5px;
    }
  }
</style>

<script is:inline>
  (function() {
    const TARGET_VOLUME = 0.32;
    const audio = document.getElementById('ambient-sea-audio');
    const toggleBtn = document.getElementById('ambient-audio-toggle');
    const eqBars = document.getElementById('audio-eq-bars');
    const muteIcon = document.getElementById('audio-mute-icon');
    const statusLabel = document.getElementById('audio-status-label');
    const liveDot = document.getElementById('audio-live-dot');

    let isPlaying = false;
    let isMutedByUser = false;
    let fadeInterval = null;
    let playPromise = null;

    // Controllo preferenza salvata
    try {
      const savedPref = sessionStorage.getItem('capri_sea_sound');
      if (savedPref === 'muted') {
        isMutedByUser = true;
      }
    } catch (e) {}

    function updateUi(playing) {
      isPlaying = playing;
      if (!toggleBtn) return;

      if (playing) {
        toggleBtn.classList.remove('audio-paused');
        if (eqBars) eqBars.classList.remove('hidden');
        if (muteIcon) muteIcon.classList.add('hidden');
        if (statusLabel) statusLabel.textContent = 'In ascolto';
        if (liveDot) {
          liveDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-sm shadow-emerald-400/50';
        }
      } else {
        toggleBtn.classList.add('audio-paused');
        if (eqBars) eqBars.classList.add('hidden');
        if (muteIcon) muteIcon.classList.remove('hidden');
        if (statusLabel) statusLabel.textContent = 'In pausa';
        if (liveDot) {
          liveDot.className = 'w-2 h-2 rounded-full bg-white/30';
        }
      }
    }

    function fadeInAudio() {
      if (!audio) return;
      if (fadeInterval) clearInterval(fadeInterval);
      const step = 0.04;
      fadeInterval = setInterval(() => {
        if (!audio) return clearInterval(fadeInterval);
        if (audio.volume + step < TARGET_VOLUME) {
          audio.volume += step;
        } else {
          audio.volume = TARGET_VOLUME;
          clearInterval(fadeInterval);
        }
      }, 60);
    }

    function playSeaWaves() {
      if (!audio || isMutedByUser) return;
      if (fadeInterval) clearInterval(fadeInterval);
      audio.volume = 0.05;

      try {
        playPromise = audio.play();
        if (playPromise !== undefined) {
          playPromise.then(() => {
            playPromise = null;
            if (isMutedByUser) {
              audio.pause();
              audio.volume = 0;
              updateUi(false);
              return;
            }
            updateUi(true);
            fadeInAudio();
            cleanupUnlockers();
          }).catch((err) => {
            playPromise = null;
            updateUi(false);
            if (!isMutedByUser) {
              setupUnlockers();
            }
          });
        }
      } catch (e) {
        updateUi(false);
      }
    }

    function pauseSeaWaves() {
      if (!audio) return;
      if (fadeInterval) clearInterval(fadeInterval);
      updateUi(false);

      if (playPromise !== null && playPromise !== undefined) {
        playPromise.then(() => {
          audio.pause();
          audio.volume = 0;
          playPromise = null;
        }).catch(() => {
          audio.pause();
          audio.volume = 0;
          playPromise = null;
        });
      } else {
        audio.pause();
        audio.volume = 0;
      }
    }

    function unlockAudioOnGesture() {
      if (isMutedByUser) return;
      playSeaWaves();
      cleanupUnlockers();
    }

    function setupUnlockers() {
      const opts = { passive: true, once: true };
      window.addEventListener('pointerdown', unlockAudioOnGesture, opts);
      window.addEventListener('click', unlockAudioOnGesture, opts);
      window.addEventListener('scroll', unlockAudioOnGesture, opts);
      window.addEventListener('touchstart', unlockAudioOnGesture, opts);
      window.addEventListener('keydown', unlockAudioOnGesture, opts);
      window.addEventListener('wheel', unlockAudioOnGesture, opts);
    }

    function cleanupUnlockers() {
      window.removeEventListener('pointerdown', unlockAudioOnGesture);
      window.removeEventListener('click', unlockAudioOnGesture);
      window.removeEventListener('scroll', unlockAudioOnGesture);
      window.removeEventListener('touchstart', unlockAudioOnGesture);
      window.removeEventListener('keydown', unlockAudioOnGesture);
      window.removeEventListener('wheel', unlockAudioOnGesture);
    }

    // Toggle manuale utente: stop immediato al clic senza attese o fade ritardati
    if (toggleBtn) {
      // Blocca la propagazione di pointerdown e touchstart per non scatenare gli unlockers globali
      toggleBtn.addEventListener('pointerdown', function(e) {
        e.stopPropagation();
      });
      toggleBtn.addEventListener('touchstart', function(e) {
        e.stopPropagation();
      }, { passive: true });

      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        if (isPlaying) {
          isMutedByUser = true;
          try { sessionStorage.setItem('capri_sea_sound', 'muted'); } catch (e) {}
          cleanupUnlockers();
          pauseSeaWaves();
        } else {
          isMutedByUser = false;
          try { sessionStorage.removeItem('capri_sea_sound'); } catch (e) {}
          playSeaWaves();
        }
      });
    }

    // AVVIO AUTOMATICO ALL'APERTURA (se non precedentemente silenziato dall'utente)
    if (!isMutedByUser) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', playSeaWaves);
      } else {
        playSeaWaves();
      }
      window.addEventListener('load', playSeaWaves);
      setupUnlockers();
    } else {
      updateUi(false);
    }
  })();
</script>
