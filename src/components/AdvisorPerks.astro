---
// Cartier-Inspired Luxury B2B Travel Advisor Advantages (Flat, Minimal, Airy Grid)
const emailContact = "mailto:partnerships@capridmc.com?subject=Onboarding%20Agenzia%20Capri%20DMC";

const advisorPerks = [
  {
    step: "01",
    title: "Commission Integrity & Net Rates",
    description: "Transparent B2B net pricing and protected commissions. We respect your client relationships as absolute and unassailable."
  },
  {
    step: "02",
    title: "24/7 Island Command",
    description: "Whether you operate from New York, London, Dubai, or Tokyo, our on-island coordinators provide instantaneous response times with zero time-zone lag."
  },
  {
    step: "03",
    title: "White-Label Client Representation",
    description: "Upon request, our chauffeurs, skippers, and private concierges represent your luxury agency seamlessly, providing a flawless branded client touchpoint."
  },
  {
    step: "04",
    title: "Direct Maritime & Port Access",
    description: "As native Capresi, we hold direct municipal permits for restricted harbor zones, private tender drop-offs, and priority grotto access that mainland agencies cannot secure."
  },
  {
    step: "05",
    title: "Dynamic Weather Contingency",
    description: "If coastal swells affect sea departures, our team initiates immediate luxury inland alternatives: historic villa access, private cellar tastings, or helicopter transfers without missing a beat."
  },
  {
    step: "06",
    title: "VIP Bespoke Customization",
    description: "From Kosher dining coordination for Bar Mitzvahs to after-hours boutique openings along Via Camerelle, no request is beyond our local reach."
  }
];
---

<section id="advisors" aria-label="B2B Travel Advisor Advantages" class="cartier-layer-solid-white py-28 lg:py-36 px-6 lg:px-16 text-brand-navy">
  <div class="max-w-7xl mx-auto space-y-20 lg:space-y-28">
    
    <!-- Section Header (Cartier Negative Space & Typographic Rigor) -->
    <div class="max-w-3xl mx-auto text-center space-y-4 advisor-header gsap-reveal">
      <div class="inline-flex items-center justify-center gap-3">
        <span class="w-6 h-[1px] bg-brand-gold"></span>
        <span class="text-brand-gold uppercase tracking-[0.32em] text-[10px] sm:text-xs font-semibold">
          The B2B Advantage
        </span>
        <span class="w-6 h-[1px] bg-brand-gold"></span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-navy font-light leading-[1.08]">
        Why Global Luxury Advisors <br />
        <span class="italic text-brand-gold font-light">Trust Capri DMC</span>
      </h2>
      <p class="text-gray-600 font-light text-base lg:text-lg max-w-2xl mx-auto leading-relaxed">
        We serve as your dedicated, on-the-ground extension in Capri. Eliminate operational blind spots with verified local mastery.
      </p>
    </div>

    <!-- 6 Perks in Flat, Clean, Architectural Cartier Grid (Zero Bulky Boxes, Maximum Negative Space) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16">
      {advisorPerks.map((perk) => (
        <div class="advisor-card gsap-reveal space-y-4 pt-6 border-t border-gray-200/80">
          <span class="font-serif text-3xl sm:text-4xl text-brand-gold font-light block leading-none">
            {perk.step}
          </span>
          <h3 class="font-serif text-2xl text-brand-navy font-normal leading-snug">
            {perk.title}
          </h3>
          <p class="text-gray-600 font-light text-xs sm:text-sm leading-relaxed">
            {perk.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Call to Action Banner (Clean Flat Architecture) -->
    <div class="advisor-card gsap-reveal border-t border-b border-brand-navy/15 py-12 lg:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-3">
        <span class="text-brand-gold uppercase tracking-[0.25em] text-[10px] font-semibold block">
          New Agency Onboarding
        </span>
        <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal">
          Register Your Travel Agency for Direct Rates
        </h3>
        <p class="text-gray-600 font-light text-sm sm:text-base leading-relaxed max-w-2xl">
          Connect directly with our founding team to receive our 2026/2027 confidential B2B Tariff Sheet and direct advisor WhatsApp dispatch line.
        </p>
      </div>

      <div class="lg:col-span-4 flex justify-start lg:justify-end">
        <a
          href={emailContact}
          class="w-full sm:w-auto px-8 py-3.5 bg-brand-gold text-brand-navy text-[11px] uppercase tracking-[0.2em] font-semibold hover:bg-brand-navy hover:text-white transition-all text-center flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email Founding Team</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- GSAP Animation for Advisor Section -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
      gsap.fromTo(".advisor-header",
        { y: 30, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.9,
          ease: "power3.out",
          force3D: true,
          scrollTrigger: {
            trigger: "#advisors",
            start: "top 80%",
            once: true
          }
        }
      );

      gsap.fromTo(".advisor-card",
        { y: 35, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "power2.out",
          force3D: true,
          scrollTrigger: {
            trigger: "#advisors",
            start: "top 75%",
            once: true
          }
        }
      );
    }
  });
</script>
