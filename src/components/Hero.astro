---
// Cartier-Inspired Cinematic Above-the-Fold Hero Section with Full Parallax Window & Physical Layering
const emailContact = "mailto:partnerships@capridmc.com?subject=Richiesta%20Servizi%20Capri%20DMC";
---

<section
  id="hero-section"
  aria-label="Hero Introduction"
  class="cartier-parallax-window relative h-screen min-h-[680px] w-full flex flex-col justify-between items-center text-center pt-24 pb-8"
>
  <!-- Full-Bleed Fixed Parallax Mediterranean Sea Horizon Media -->
  <picture>
    <source srcset="/images/capri/capri-mediterranean-sea-horizon-hero.webp" type="image/webp" />
    <img
      id="hero-bg"
      src="/images/capri/capri-mediterranean-sea-horizon-hero.jpg"
      alt="Capri Mediterranean Sea Horizon - Capri DMC Luxury Destination Management"
      class="cartier-parallax-bg scale-105 filter brightness-105 will-change-transform"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  
  <!-- Cartier-Style Fixed Editorial Gradients (Clipped to Window) -->
  <div class="fixed inset-0 bg-gradient-to-b from-[#07142E]/75 via-[#07142E]/30 to-[#07142E]/85 pointer-events-none z-[1]"></div>
  <div class="fixed inset-0 bg-[radial-gradient(circle_at_center,rgba(212,175,55,0.08)_0%,transparent_70%)] pointer-events-none z-[1]"></div>

  <!-- Top Spacer for Sticky Navbar -->
  <div class="w-full h-12 relative z-10 pointer-events-none"></div>

  <!-- Central Editorial Masterpiece (Cartier Structure) -->
  <div id="hero-content" class="relative z-10 max-w-4xl px-6 lg:px-12 flex flex-col items-center my-auto will-change-transform">
    
    <!-- Official Medallion Logo as Luxury Hallmark Seal -->
    <div class="hero-item gsap-reveal mb-5 flex flex-col items-center">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="Capri DMC Official Crest Hallmark"
          width="80"
          height="80"
          class="w-16 h-16 md:w-20 md:h-20 rounded-full object-contain ring-1 ring-brand-gold/70 p-1"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <!-- Editorial Tagline & Heritage Credentials -->
    <div class="hero-item gsap-reveal mb-4 flex items-center justify-center gap-3">
      <span class="w-6 h-[1px] bg-brand-gold/60"></span>
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.32em] font-medium text-brand-gold/90">
        Women-Owned · 24/7 Ground Dispatch · Capri, Italy
      </span>
      <span class="w-6 h-[1px] bg-brand-gold/60"></span>
    </div>

    <!-- Minimalist Title with Editorial Garamond Serif -->
    <h1 class="hero-item gsap-reveal font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-white font-light leading-[1.04] tracking-tight mb-4">
      Your Destination <br />
      <span class="italic text-brand-gold font-light">Management</span> Company
    </h1>

    <!-- Editorial Motto -->
    <div class="hero-item gsap-reveal mb-6">
      <span class="text-xs sm:text-sm uppercase tracking-[0.35em] text-white/90 font-light">
        Your Roots in Capri
      </span>
    </div>

    <!-- Subtitle / Value Proposition for Global Luxury Advisors -->
    <p class="hero-item gsap-reveal text-white/80 font-light max-w-2xl text-sm sm:text-base md:text-lg leading-relaxed mb-8">
      The elite B2B spin-off from <strong class="text-white font-medium">Nesea Capri Tours & Events</strong>. Providing bespoke private yacht charters, high-end island celebrations, and seamless airport-to-suite logistics for global luxury travel advisors.
    </p>

    <!-- Clean, Flat Luxury Call to Action (Cartier Minimalist Buttons) -->
    <div class="hero-item gsap-reveal flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full sm:w-auto">
      <a
        href="#services"
        class="w-full sm:w-auto px-9 py-3.5 border border-white/80 text-white text-[11px] uppercase tracking-[0.25em] font-medium hover:bg-white hover:text-brand-navy transition-all duration-300 text-center"
      >
        Curated Services
      </a>

      <a
        href={emailContact}
        class="w-full sm:w-auto px-9 py-3.5 bg-brand-gold text-brand-navy text-[11px] uppercase tracking-[0.25em] font-semibold hover:bg-white transition-all duration-300 text-center flex items-center justify-center gap-2"
      >
        <span>Email Advisor Desk</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>

  <!-- Bottom: 3 Core Value Pillars & Subtle Scroll Cue -->
  <div class="relative z-10 w-full max-w-5xl px-6 border-t border-white/10 pt-4 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/60 font-light">
    
    <!-- 3 Pillars (Clean, Flat, Rigorous Typography) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 w-full md:w-auto text-left">
      <div class="flex items-center gap-3">
        <span class="font-serif text-lg text-brand-gold font-light">01</span>
        <div>
          <h4 class="text-[10px] uppercase tracking-wider text-white font-medium">From Capri for Capri</h4>
          <p class="text-[9px] text-white/50">100% Native on-island team</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="font-serif text-lg text-brand-gold font-light">02</span>
        <div>
          <h4 class="text-[10px] uppercase tracking-wider text-white font-medium">24/7 Command</h4>
          <p class="text-[9px] text-white/50">Zero time-zone delay</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="font-serif text-lg text-brand-gold font-light">03</span>
        <div>
          <h4 class="text-[10px] uppercase tracking-wider text-white font-medium">White-Label Mastery</h4>
          <p class="text-[9px] text-white/50">Discreet VIP execution</p>
        </div>
      </div>
    </div>

    <!-- Scroll Cue -->
    <a
      href="#story"
      class="hidden md:inline-flex items-center gap-2 text-[9px] uppercase tracking-[0.25em] text-white/50 hover:text-brand-gold transition-colors"
      aria-label="Scroll to discover the Maison"
    >
      <span>Scroll</span>
      <svg class="w-3.5 h-3.5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7 7m7 7V3" />
      </svg>
    </a>

  </div>
</section>

<!-- GSAP Reveal Script for Hero & Parallax Scroll Departure -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined") {
      const heroTl = gsap.timeline({ delay: 0.2 });

      heroTl
        .to("#hero-bg", {
          scale: 1,
          duration: 3.2,
          ease: "power2.out",
          force3D: true
        }, 0)
        .fromTo(".hero-item",
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 1,
            stagger: 0.1,
            ease: "power3.out",
            force3D: true
          },
          0.2
        );

      // Parallax smooth departure on scroll: content fades and glides slightly down as the next section slides on top
      if (typeof ScrollTrigger !== "undefined") {
        gsap.to("#hero-content", {
          y: 80,
          opacity: 0,
          ease: "none",
          scrollTrigger: {
            trigger: "#hero-section",
            start: "top top",
            end: "bottom top",
            scrub: 0.6
          }
        });
      }
    }
  });
</script>
