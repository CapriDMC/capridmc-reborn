---
// Cinematic Sun-Drenched Editorial Hero Section with Authentic Capri Photography & Medallion Logo
const contactUrl = "https://www.capridmc.com/contact-us-capri-destination-management-company/";
---

<section aria-label="Hero Introduction" class="relative min-h-screen flex items-center justify-center text-center overflow-hidden bg-brand-dark pt-28 pb-20">
  <!-- Authentic Capri Mediterranean Sea Horizon Background (from capridmc.com) -->
  <div class="absolute inset-0 z-0">
    <img
      id="hero-bg"
      src="/images/capri/capri-mediterranean-sea-horizon-hero.jpg"
      alt="Capri Mediterranean Sea Horizon - Capri DMC Luxury Destination Management"
      width="1620"
      height="1080"
      class="w-full h-full object-cover object-center opacity-65 scale-110 filter brightness-100"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Editorial Vignette & Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/50 to-brand-dark/75"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(212,175,55,0.12)_0%,transparent_75%)] pointer-events-none"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-10 max-w-5xl px-6 lg:px-12 flex flex-col items-center">
    
    <!-- Official Medallion Logo in Hero Crest Presentation -->
    <div class="hero-item gsap-reveal mb-6 flex flex-col items-center">
      <div class="relative p-1 rounded-full bg-gradient-to-b from-brand-gold/60 to-brand-navy/40 shadow-2xl">
        <img
          src="/logo.png"
          alt="Capri DMC Official Crest"
          width="96"
          height="96"
          class="w-20 h-20 md:w-24 md:h-24 rounded-full object-contain shadow-2xl ring-2 ring-brand-gold/80"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <!-- Top Pill Badge / Credentials -->
    <div class="hero-item gsap-reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-6 shadow-lg">
      <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
      <span class="text-[10px] md:text-xs uppercase tracking-[0.3em] font-semibold text-white/90">
        Women-Owned · 24/7 Ground Dispatch · Capri, Italy
      </span>
    </div>

    <!-- Editorial Motto -->
    <span class="hero-item gsap-reveal text-brand-gold uppercase tracking-[0.35em] text-xs md:text-sm font-semibold mb-6 flex items-center gap-3">
      <span class="w-8 h-[1px] bg-brand-gold/60 inline-block"></span>
      Your Roots in Capri
      <span class="w-8 h-[1px] bg-brand-gold/60 inline-block"></span>
    </span>

    <!-- Main Headline with Serif Typography -->
    <h1 class="hero-item gsap-reveal font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-white font-normal leading-[1.08] tracking-tight mb-8 drop-shadow-2xl">
      Your Destination <br />
      <span class="font-serif italic text-brand-gold font-normal">Management</span> Company
    </h1>

    <!-- Subtitle / Value Proposition for B2B Advisors & VIPs -->
    <p class="hero-item gsap-reveal text-white/85 font-light max-w-2xl text-base sm:text-lg md:text-xl leading-relaxed mb-10">
      The elite B2B spin-off from <strong class="text-white font-medium">Nesea Capri Tours & Events</strong>. Providing bespoke private yacht charters, high-end island celebrations, and seamless airport-to-suite logistics for global luxury travel advisors.
    </p>

    <!-- Dual Luxury CTAs -->
    <div class="hero-item gsap-reveal flex flex-col sm:flex-row items-center gap-4 sm:gap-6 w-full sm:w-auto">
      <a
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-9 py-4 bg-brand-gold text-brand-navy font-semibold text-xs uppercase tracking-[0.2em] shadow-xl hover:bg-white hover:shadow-brand-gold/20 transition-all duration-300 ease-out group flex items-center justify-center gap-2"
      >
        <span>Schedule B2B Appointment</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="#services"
        class="w-full sm:w-auto px-9 py-4 bg-white/5 hover:bg-white/10 text-white font-medium text-xs uppercase tracking-[0.2em] border border-white/20 hover:border-brand-gold transition-all duration-300 backdrop-blur-sm"
      >
        Explore Island Portfolio
      </a>
    </div>

    <!-- Quick Mottos / Value Pillars Footer -->
    <div class="hero-item gsap-reveal grid grid-cols-2 md:grid-cols-3 gap-6 pt-14 mt-8 border-t border-white/10 w-full max-w-3xl text-left text-white/70">
      <div class="flex items-center gap-3">
        <span class="text-brand-gold font-serif text-2xl font-light">01</span>
        <div>
          <h4 class="text-[11px] uppercase tracking-wider text-white font-semibold">From Capri for Capri</h4>
          <p class="text-[10px] text-white/50">100% Native on-island team</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-brand-gold font-serif text-2xl font-light">02</span>
        <div>
          <h4 class="text-[11px] uppercase tracking-wider text-white font-semibold">24/7 Operational Command</h4>
          <p class="text-[10px] text-white/50">Zero time-zone delay for advisors</p>
        </div>
      </div>
      <div class="hidden md:flex items-center gap-3">
        <span class="text-brand-gold font-serif text-2xl font-light">03</span>
        <div>
          <h4 class="text-[11px] uppercase tracking-wider text-white font-semibold">White-Label Representation</h4>
          <p class="text-[10px] text-white/50">Discreet VIP service execution</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Scroll Down Indicator -->
  <a
    href="#story"
    class="hero-item gsap-reveal absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50 hover:text-brand-gold transition-colors duration-300"
    aria-label="Scroll to discover The Authority"
  >
    <span class="text-[9px] uppercase tracking-[0.3em] font-semibold">Scroll to Explore</span>
    <div class="w-[1px] h-10 bg-gradient-to-b from-brand-gold to-transparent animate-pulse"></div>
  </a>
</section>

<!-- Hero Section GSAP Animation Script -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined") {
      const heroTl = gsap.timeline({ delay: 0.2 });

      heroTl
        .to("#hero-bg", {
          scale: 1,
          duration: 3.5,
          ease: "power2.out"
        }, 0)
        .fromTo(".hero-item",
          { y: 35, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 1.1,
            stagger: 0.12,
            ease: "power3.out"
          },
          0.3
        );
    }
  });
</script>
