---
// Luxury Editorial Footer with Circular Logo & Complete Business Profile
const emailContact = "mailto:partnerships@capridmc.com?subject=Richiesta%20Informazioni%20Capri%20DMC";
const phoneContact = "tel:+393335943947";
const whatsappContact = "https://wa.me/393335943947?text=Buongiorno%20Capri%20DMC%2C%20desidero%20informazioni%20sui%20vostri%20servizi%20di%20destination%20management.";
---

<footer id="contact" aria-label="Site Footer" class="bg-brand-dark text-white pt-24 pb-12 px-6 lg:px-12 border-t border-white/10 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-16 border-b border-white/10 pb-20 mb-12">
      
      <!-- Brand & Mission Column (Spans 2 cols) -->
      <div class="lg:col-span-2 space-y-6">
        <a href="#" class="flex items-center gap-4 focus:outline-none group" aria-label="Capri DMC Home">
          <picture>
            <source srcset="/logo.webp" type="image/webp" />
            <img
              src="/logo.png"
              alt="Capri DMC Logo"
              width="64"
              height="64"
              class="h-16 w-16 rounded-full object-contain ring-1 ring-brand-gold/60 shadow-xl transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div>
            <span class="font-serif text-2xl font-normal block leading-tight text-white">Capri DMC</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-brand-gold font-medium">Your Roots in Capri</span>
          </div>
        </a>
        
        <p class="text-white/70 font-light text-sm leading-relaxed max-w-md">
          Capri Destination Management Company is the elite Business-to-Business spin-off from <strong class="text-white font-medium">Nesea Capri Tours & Events</strong>. Dedicated to travel advisors and high-net-worth travelers seeking verified on-island mastery.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-brand-gold text-[10px] uppercase tracking-widest font-semibold border border-brand-gold/30">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
            Women-Owned
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-white/90 text-[10px] uppercase tracking-widest font-semibold border border-white/15">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            24/7 Island Dispatch
          </span>
        </div>

        <div class="pt-2">
          <span class="text-xs font-serif italic text-white/50">"From Capri for Capri" · "Your Roots in Capri"</span>
        </div>
      </div>

      <!-- Column 2: Exclusive Solutions -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Exclusive Solutions</h4>
        <ul class="space-y-2.5 text-xs text-white/70 font-light">
          <li>
            <a href="#services-boats" class="hover:text-brand-gold transition-colors">Private Boat Tours & Gozzo</a>
          </li>
          <li>
            <a href="#services-transfers" class="hover:text-brand-gold transition-colors">Airport-to-Suite Transfers</a>
          </li>
          <li>
            <a href="#services-concierge" class="hover:text-brand-gold transition-colors">Dedicated 24/7 Conciergerie</a>
          </li>
          <li>
            <a href="#services-events" class="hover:text-brand-gold transition-colors">Weddings & Bar Mitzvah Events</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Custom Experiences -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Custom Experiences</h4>
        <ul class="space-y-2.5 text-xs text-white/70 font-light">
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Exclusive Guided Island Tours</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Artisanal Sandals & Textiles</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Cooking Classes in Caprese Homes</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Personal Shopper & Worldwide Shipping</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Hidden Hiking & Secret Routes</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Personal Trainer & Marine Sports</a>
          </li>
          <li>
            <a href="#experiences" class="hover:text-brand-gold transition-colors">Babysitting & Pet Sitting in Capri</a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Headquarters & B2B Desk -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Capri Operations</h4>
        <div class="space-y-3 text-xs text-white/70 font-light">
          <p>
            80076 Capri<br />
            Metropolitan City of Naples<br />
            Campania, Italy
          </p>
          <div class="pt-1">
            <span class="text-[10px] uppercase tracking-wider text-white/40 block flex items-center gap-1.5">
              <span>24/7 Direct Advisor Line</span>
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" title="WhatsApp Live Desk"></span>
            </span>
            <a
              href={whatsappContact}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-brand-gold hover:text-emerald-400 transition-colors font-mono text-sm font-medium group"
              title="Apri conversazione WhatsApp con Capri DMC"
              aria-label="Contatta direttamente su WhatsApp al +39 333 594 3947"
            >
              <svg class="w-4 h-4 text-emerald-400 group-hover:scale-110 transition-transform shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>+39 333 594 3947</span>
            </a>
            <span class="block text-[9px] text-emerald-400/80 font-light mt-0.5">Click to chat on WhatsApp</span>
          </div>
          <div class="pt-2">
            <span class="text-[10px] uppercase tracking-wider text-white/40 block">Email Ufficiale</span>
            <a href={emailContact} class="text-brand-gold hover:text-white transition-colors font-mono text-xs font-medium">
              partnerships@capridmc.com
            </a>
          </div>
          <div class="pt-1">
            <a href="/ai-context" class="hover:text-brand-gold transition-colors inline-flex items-center gap-1.5 text-white/60 text-xs">
              <span>AI Context Dossier</span>
              <span class="text-[9px] bg-brand-gold/20 text-brand-gold px-1.5 py-0.2 rounded font-mono">GEO</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Attributes -->
    <div class="flex flex-col md:flex-row justify-between items-center text-xs text-white/40 font-light gap-4">
      <div class="flex flex-wrap items-center gap-4 text-center md:text-left">
        <p>&copy; {new Date().getFullYear()} Capri Destination Management Company. All rights reserved.</p>
        <span class="hidden md:inline text-white/20">|</span>
        <p>A Women-Owned Enterprise · Spin-off from Nesea Capri Tours & Events</p>
        <span class="hidden md:inline text-white/20">|</span>
        <button
          type="button"
          data-open-cookie-preferences
          class="hover:text-brand-gold transition-colors text-white/60 underline underline-offset-4 cursor-pointer"
        >
          Preferenze Cookie & Privacy
        </button>
      </div>

      <div class="flex items-center gap-6 text-[11px] uppercase tracking-widest text-brand-gold/80 font-semibold">
        <span>From Capri for Capri</span>
        <span>·</span>
        <span>Your Roots in Capri</span>
      </div>
    </div>

  </div>
</footer>
