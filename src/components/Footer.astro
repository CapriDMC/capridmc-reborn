---
// Luxury Editorial Footer with Circular Logo & Complete Business Profile
const contactUrl = "https://www.capridmc.com/contact-us-capri-destination-management-company/";
---

<footer aria-label="Site Footer" class="bg-brand-dark text-white pt-24 pb-12 px-6 lg:px-12 border-t border-white/10 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-16 border-b border-white/10 pb-20 mb-12">
      
      <!-- Brand & Mission Column (Spans 2 cols) -->
      <div class="lg:col-span-2 space-y-6">
        <a href="#" class="flex items-center gap-4 focus:outline-none group" aria-label="Capri DMC Home">
          <img
            src="/logo.png"
            alt="Capri DMC Logo"
            width="64"
            height="64"
            class="h-16 w-16 rounded-full object-contain ring-1 ring-brand-gold/60 shadow-xl transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div>
            <span class="font-serif text-2xl font-normal block leading-tight text-white">Capri DMC</span>
            <span class="text-[9px] uppercase tracking-[0.25em] text-brand-gold font-medium">Your Roots in Capri</span>
          </div>
        </a>
        
        <p class="text-white/70 font-light text-sm leading-relaxed max-w-md">
          Capri Destination Management Company is the elite Business-to-Business spin-off from <strong class="text-white font-medium">Nesea Capri Tours & Events</strong>. Dedicated to travel advisors and high-net-worth travelers seeking verified on-island mastery.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-brand-gold text-[10px] uppercase tracking-widest font-semibold border border-brand-gold/30">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
            Women-Owned
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 text-white/90 text-[10px] uppercase tracking-widest font-semibold border border-white/15">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            24/7 Island Dispatch
          </span>
        </div>

        <div class="pt-2">
          <span class="text-xs font-serif italic text-white/50">"From Capri for Capri" · "Your Roots in Capri"</span>
        </div>
      </div>

      <!-- Column 2: Exclusive Solutions -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Exclusive Solutions</h4>
        <ul class="space-y-2.5 text-xs text-white/70 font-light">
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Private Boat Tours & Gozzo</a>
          </li>
          <li>
            <a href="#logistics" class="hover:text-brand-gold transition-colors">Airport-to-Suite Transfers</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Dedicated 24/7 Conciergerie</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Weddings & Bar Mitzvah Events</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Custom Experiences -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Custom Experiences</h4>
        <ul class="space-y-2.5 text-xs text-white/70 font-light">
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Exclusive Guided Island Tours</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Artisanal Sandals & Textiles</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Cooking Classes in Caprese Homes</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Personal Shopper & Worldwide Shipping</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Hidden Hiking & Secret Routes</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Personal Trainer & Marine Sports</a>
          </li>
          <li>
            <a href="#services" class="hover:text-brand-gold transition-colors">Babysitting & Pet Sitting in Capri</a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Headquarters & B2B Desk -->
      <div class="space-y-4">
        <h4 class="font-serif text-lg text-brand-gold tracking-wide">Capri Operations</h4>
        <div class="space-y-3 text-xs text-white/70 font-light">
          <p>
            80076 Capri<br />
            Metropolitan City of Naples<br />
            Campania, Italy
          </p>
          <div class="pt-1">
            <span class="text-[10px] uppercase tracking-wider text-white/40 block">24/7 Direct Advisor Line</span>
            <a href="tel:+393335943947" class="text-brand-gold hover:text-white transition-colors font-mono text-sm font-medium">
              +39 333 594 3947
            </a>
          </div>
          <div class="pt-1 space-y-1.5">
            <a href="/ai-context.txt" target="_blank" class="hover:text-brand-gold transition-colors flex items-center gap-1.5 text-white/60">
              <span>AI Context Dossier</span>
              <span class="text-[9px] bg-brand-gold/20 text-brand-gold px-1.5 py-0.2 rounded font-mono">GEO</span>
            </a>
            <a
              href={contactUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-[10px] uppercase tracking-[0.2em] font-semibold text-brand-gold border-b border-brand-gold/60 pb-1 hover:text-white hover:border-white transition-all pt-1"
            >
              Request Advisor Appointment &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Attributes -->
    <div class="flex flex-col md:flex-row justify-between items-center text-xs text-white/40 font-light gap-4">
      <div class="flex flex-wrap items-center gap-4 text-center md:text-left">
        <p>&copy; {new Date().getFullYear()} Capri Destination Management Company. All rights reserved.</p>
        <span class="hidden md:inline text-white/20">|</span>
        <p>A Women-Owned Enterprise · Spin-off from Nesea Capri Tours & Events</p>
      </div>

      <div class="flex items-center gap-6 text-[11px] uppercase tracking-widest text-brand-gold/80 font-semibold">
        <span>From Capri for Capri</span>
        <span>·</span>
        <span>Your Roots in Capri</span>
      </div>
    </div>

  </div>
</footer>
