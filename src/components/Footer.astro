---
// Concise Luxury Editorial Footer & Presentation
const emailContact = "mailto:partnerships@capridmc.com?subject=Richiesta%20Informazioni%20Capri%20DMC";
const phoneContact = "tel:+393335943947";
const whatsappContact = "https://wa.me/393335943947?text=Buongiorno%20Capri%20DMC%2C%20desidero%20informazioni%20sui%20vostri%20servizi%20di%20destination%20management.";
---

<footer id="contact" aria-label="Site Footer" class="bg-brand-dark text-white py-20 lg:py-24 px-6 lg:px-16 border-t border-white/10 relative overflow-hidden">
  
  <div class="max-w-5xl mx-auto flex flex-col items-center text-center space-y-10">
    
    <!-- Hallmark Medallion Logo -->
    <div class="flex flex-col items-center">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="Capri DMC Official Crest"
          width="88"
          height="88"
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-contain ring-1 ring-brand-gold/60 p-1 shadow-2xl"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <span class="font-serif text-2xl sm:text-3xl font-light tracking-[0.2em] uppercase text-white mt-4">
        Capri DMC
      </span>
      <span class="text-[10px] uppercase tracking-[0.3em] text-brand-gold font-medium mt-1">
        B2B Destination Management
      </span>
    </div>

    <!-- Brief Luxury Presentation -->
    <div class="max-w-2xl space-y-4">
      <p class="text-white/80 font-light text-sm sm:text-base leading-relaxed">
        Curated by <strong class="text-white font-medium">Team Nesea</strong>. Capri Destination Management Company coordinates bespoke private boat services, high-end island celebrations, white-label client representation, and seamless arrival logistics for luxury travel designers and discerning travelers worldwide.
      </p>
      <p class="text-xs text-brand-gold font-light tracking-wide italic">
        "Always present and reliable on the island: we live here."
      </p>
    </div>

    <!-- Key Credential Badges -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded border border-white/15 text-[10px] uppercase tracking-wider text-brand-gold font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
        Women-Owned
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded border border-white/15 text-[10px] uppercase tracking-wider text-white/90 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        On-Ground Dispatch
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded border border-white/15 text-[10px] uppercase tracking-wider text-white/70 font-medium">
        Capri, Italy
      </span>
    </div>

    <!-- Direct Contact Links -->
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 pt-4 border-t border-white/10 w-full text-xs font-light">
      <div>
        <span class="text-[9px] uppercase tracking-wider text-white/40 block mb-1">Official Desk</span>
        <a href={emailContact} class="text-brand-gold hover:text-white transition-colors font-mono text-xs">
          partnerships@capridmc.com
        </a>
      </div>

      <div>
        <span class="text-[9px] uppercase tracking-wider text-white/40 block mb-1">Direct Advisor Line</span>
        <a
          href={whatsappContact}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-white hover:text-emerald-400 transition-colors font-mono text-xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>+39 333 594 3947</span>
        </a>
      </div>

      <div>
        <span class="text-[9px] uppercase tracking-wider text-white/40 block mb-1">Headquarters</span>
        <span class="text-white/60 text-xs">
          80076 Capri (NA), Italy
        </span>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Attributes -->
    <div class="pt-6 border-t border-white/10 w-full flex flex-col sm:flex-row items-center justify-between text-xs text-white/40 font-light gap-4">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4">
        <p>&copy; {new Date().getFullYear()} Capri Destination Management Company. All rights reserved.</p>
        <span class="hidden sm:inline text-white/20">|</span>
        <button
          type="button"
          data-open-cookie-preferences
          class="hover:text-brand-gold transition-colors text-white/60 underline underline-offset-4 cursor-pointer"
        >
          Cookie &amp; Privacy Preferences
        </button>
      </div>

      <div class="text-[10px] uppercase tracking-widest text-brand-gold/80 font-medium">
        Proudly Owned by Caprese People
      </div>
    </div>

  </div>
</footer>
