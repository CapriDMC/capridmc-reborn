---
// Cartier-Inspired Alternating 50/50 Editorial Services Architecture & Full-Bleed Parallax Windows
import servicesData from '../data/services.json';

const emailContact = "mailto:partnerships@capridmc.com?subject=Richiesta%20Servizi%20Capri%20DMC";

const toWebp = (path: string) => path ? path.replace(/\.(jpg|jpeg|png)$/, '.webp') : '';

const exclusiveSolutions = servicesData.filter(s => s.cluster === "Exclusive Solutions");
const customExperiences = servicesData.filter(s => s.cluster === "Custom Experiences");
---

<!-- ================================================================= -->
<!-- SECTION: CURATED B2B PORTFOLIO (CARTIER LUXURY ARCHITECTURE)      -->
<!-- ================================================================= -->
<section id="services" aria-label="Curated B2B Services Catalog" class="relative">

  <!-- =============================================================== -->
  <!-- LAYER 1 (SOLID CREAM): EXCLUSIVE SOLUTIONS PART 1 (BOATS & TAXIS)-->
  <!-- =============================================================== -->
  <div class="cartier-layer-solid-light py-28 lg:py-36 px-6 lg:px-16 text-brand-navy">
    <div class="max-w-7xl mx-auto space-y-24 lg:space-y-32">

      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center space-y-4 service-fade-item gsap-reveal">
        <div class="inline-flex items-center justify-center gap-3">
          <span class="w-6 h-[1px] bg-brand-gold"></span>
          <span class="text-brand-gold uppercase tracking-[0.32em] text-[10px] sm:text-xs font-semibold">
            Full Portfolio · Exclusive Solutions
          </span>
          <span class="w-6 h-[1px] bg-brand-gold"></span>
        </div>
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-navy font-light leading-[1.08]">
          Our Curated B2B Services
        </h2>
        <p class="text-gray-600 font-light text-base lg:text-lg max-w-2xl mx-auto leading-relaxed">
          Every offering presented across <strong class="text-brand-navy font-medium">Capri DMC</strong> is engineered exclusively for luxury travel agencies, Virtuoso advisors, and discerning VIP clients.
        </p>
      </div>

      <!-- 50/50 Row 1: Capri Private Boat Tours (Image Left | Text Right) -->
      <div id="services-boats" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <!-- Image Column (6 cols) -->
        <div class="lg:col-span-6 service-fade-item gsap-reveal">
          <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden bg-gray-200">
            <picture class="w-full h-full block">
              <source srcset={toWebp(exclusiveSolutions[0].image)} type="image/webp" />
              <img
                src={exclusiveSolutions[0].image}
                alt={exclusiveSolutions[0].title}
                width="1600"
                height="1200"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute top-6 left-6">
              <span class="text-[9px] uppercase tracking-[0.25em] text-white bg-[#07142E]/80 backdrop-blur-md px-3 py-1 font-medium border border-white/15">
                {exclusiveSolutions[0].badge}
              </span>
            </div>
          </div>
        </div>

        <!-- Text Column (6 cols) -->
        <div class="lg:col-span-6 space-y-6 service-fade-item gsap-reveal">
          <div class="space-y-2">
            <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">01 / Maritime Fleet</span>
            <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal leading-tight">
              {exclusiveSolutions[0].title}
            </h3>
            <p class="text-xs sm:text-sm uppercase tracking-wider text-brand-gold font-medium">
              {exclusiveSolutions[0].subtitle}
            </p>
          </div>

          <p class="text-gray-600 font-light text-sm sm:text-base leading-relaxed">
            {exclusiveSolutions[0].description}
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-gray-200 text-xs sm:text-sm text-gray-700 font-light">
            {exclusiveSolutions[0].b2b_features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-1.5 shrink-0"></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="pt-2">
            <a
              href={emailContact}
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-brand-navy hover:text-brand-gold transition-colors pb-1 border-b border-brand-navy/30 hover:border-brand-gold"
            >
              <span>Reserve Private Vessel</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 50/50 Row 2: Transfers & Suite Check-In (Text Left | Image Right) - INVERTED -->
      <div id="services-transfers" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <!-- Text Column (6 cols, Inverted Left) -->
        <div class="lg:col-span-6 order-2 lg:order-1 space-y-6 service-fade-item gsap-reveal">
          <div class="space-y-2">
            <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">02 / Seamless Passage</span>
            <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal leading-tight">
              {exclusiveSolutions[1].title}
            </h3>
            <p class="text-xs sm:text-sm uppercase tracking-wider text-brand-gold font-medium">
              {exclusiveSolutions[1].subtitle}
            </p>
          </div>

          <p class="text-gray-600 font-light text-sm sm:text-base leading-relaxed">
            {exclusiveSolutions[1].description}
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-gray-200 text-xs sm:text-sm text-gray-700 font-light">
            {exclusiveSolutions[1].b2b_features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-1.5 shrink-0"></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="pt-2 flex flex-wrap items-center gap-6">
            <a
              href="#logistics"
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-brand-navy hover:text-brand-gold transition-colors pb-1 border-b border-brand-navy/30 hover:border-brand-gold"
            >
              <span>Explore 3D Logistics Globe</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Image Column (6 cols, Inverted Right) -->
        <div class="lg:col-span-6 order-1 lg:order-2 service-fade-item gsap-reveal">
          <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden bg-gray-200">
            <picture class="w-full h-full block">
              <source srcset={toWebp(exclusiveSolutions[1].image)} type="image/webp" />
              <img
                src={exclusiveSolutions[1].image}
                alt={exclusiveSolutions[1].title}
                width="1600"
                height="1200"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute top-6 left-6">
              <span class="text-[9px] uppercase tracking-[0.25em] text-white bg-[#07142E]/80 backdrop-blur-md px-3 py-1 font-medium border border-white/15">
                {exclusiveSolutions[1].badge}
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- =============================================================== -->
  <!-- PARALLAX BAND 1: FULL-BLEED FIXED PANORAMIC WINDOW              -->
  <!-- =============================================================== -->
  <div class="cartier-parallax-window min-h-[70vh] lg:min-h-[80vh] flex items-center justify-center text-center px-6 py-20 relative">
    <!-- Fixed Hardware-Accelerated Background -->
    <picture>
      <source srcset="/images/capri/anacapri-lighthouse-cliffside.webp" type="image/webp" />
      <img
        src="/images/capri/anacapri-lighthouse-cliffside.jpg"
        alt="Capri Cliffside Panoramic Horizon"
        class="cartier-parallax-bg"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-[#07142E]/65 pointer-events-none"></div>

    <!-- Centered Editorial Typography Overlay -->
    <div class="relative z-10 max-w-4xl mx-auto space-y-6 text-white parallax-quote gsap-reveal">
      <span class="text-brand-gold uppercase tracking-[0.35em] text-xs font-semibold block">
        Capri Island Command · Est. 2010
      </span>
      <h3 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-white font-light leading-tight italic">
        "Uncompromised logistical execution, guaranteed peak-season private fleet access, and round-the-clock ground dispatch."
      </h3>
      <p class="text-white/70 font-light text-xs sm:text-sm uppercase tracking-[0.25em]">
        From Capri for Capri · Direct Native Bridge
      </p>
    </div>
  </div>

  <!-- =============================================================== -->
  <!-- LAYER 2 (SOLID NAVY): EXCLUSIVE SOLUTIONS PART 2 (CONCIERGE & WEDDINGS) -->
  <!-- =============================================================== -->
  <div class="cartier-layer-solid-dark py-28 lg:py-36 px-6 lg:px-16 text-white">
    <div class="max-w-7xl mx-auto space-y-24 lg:space-y-32">

      <!-- 50/50 Row 3: Dedicated 24/7 Island Conciergerie (Image Left | Text Right) -->
      <div id="services-concierge" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <!-- Image Column (6 cols) -->
        <div class="lg:col-span-6 service-fade-item gsap-reveal">
          <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden bg-black/40">
            <picture class="w-full h-full block">
              <source srcset={toWebp(exclusiveSolutions[2].image)} type="image/webp" />
              <img
                src={exclusiveSolutions[2].image}
                alt={exclusiveSolutions[2].title}
                width="1600"
                height="1200"
                class="w-full h-full object-cover opacity-85"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute top-6 left-6">
              <span class="text-[9px] uppercase tracking-[0.25em] text-brand-gold bg-[#07142E]/90 backdrop-blur-md px-3 py-1 font-medium border border-brand-gold/30">
                {exclusiveSolutions[2].badge}
              </span>
            </div>
          </div>
        </div>

        <!-- Text Column (6 cols) -->
        <div class="lg:col-span-6 space-y-6 service-fade-item gsap-reveal">
          <div class="space-y-2">
            <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">03 / On-Island Command</span>
            <h3 class="font-serif text-3xl sm:text-4xl text-white font-normal leading-tight">
              {exclusiveSolutions[2].title}
            </h3>
            <p class="text-xs sm:text-sm uppercase tracking-wider text-brand-gold font-medium">
              {exclusiveSolutions[2].subtitle}
            </p>
          </div>

          <p class="text-white/75 font-light text-sm sm:text-base leading-relaxed">
            {exclusiveSolutions[2].description}
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-white/10 text-xs sm:text-sm text-white/80 font-light">
            {exclusiveSolutions[2].b2b_features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-1.5 shrink-0"></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="pt-2 flex flex-wrap items-center gap-6">
            <a
              href={emailContact}
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-brand-gold hover:text-white transition-colors pb-1 border-b border-brand-gold/40 hover:border-white"
            >
              <span>Inquire Conciergerie Desk</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 50/50 Row 4: Weddings & Bar Mitzvahs (Text Left | Image Right) - INVERTED -->
      <div id="services-events" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <!-- Text Column (6 cols, Inverted Left) -->
        <div class="lg:col-span-6 order-2 lg:order-1 space-y-6 service-fade-item gsap-reveal">
          <div class="space-y-2">
            <span class="text-brand-gold font-serif text-2xl lg:text-3xl italic block">04 / Milestone Celebrations</span>
            <h3 class="font-serif text-3xl sm:text-4xl text-white font-normal leading-tight">
              {exclusiveSolutions[3].title}
            </h3>
            <p class="text-xs sm:text-sm uppercase tracking-wider text-brand-gold font-medium">
              {exclusiveSolutions[3].subtitle}
            </p>
          </div>

          <p class="text-white/75 font-light text-sm sm:text-base leading-relaxed">
            {exclusiveSolutions[3].description}
          </p>

          <ul class="space-y-2.5 pt-2 border-t border-white/10 text-xs sm:text-sm text-white/80 font-light">
            {exclusiveSolutions[3].b2b_features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-1.5 shrink-0"></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="pt-2">
            <a
              href={emailContact}
              class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-brand-gold hover:text-white transition-colors pb-1 border-b border-brand-gold/40 hover:border-white"
            >
              <span>Coordinate Milestone Event</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Image Column (6 cols, Inverted Right) -->
        <div class="lg:col-span-6 order-1 lg:order-2 service-fade-item gsap-reveal">
          <div class="img-zoom-container aspect-[4/3] w-full relative overflow-hidden bg-black/40">
            <picture class="w-full h-full block">
              <source srcset={toWebp(exclusiveSolutions[3].image)} type="image/webp" />
              <img
                src={exclusiveSolutions[3].image}
                alt={exclusiveSolutions[3].title}
                width="1600"
                height="1200"
                class="w-full h-full object-cover opacity-85"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute top-6 left-6">
              <span class="text-[9px] uppercase tracking-[0.25em] text-brand-gold bg-[#07142E]/90 backdrop-blur-md px-3 py-1 font-medium border border-brand-gold/30">
                {exclusiveSolutions[3].badge}
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- =============================================================== -->
  <!-- PARALLAX BAND 2: FULL-BLEED FIXED DRAMATIC COASTLINE WINDOW     -->
  <!-- =============================================================== -->
  <div class="cartier-parallax-window min-h-[70vh] lg:min-h-[80vh] flex items-center justify-center text-center px-6 py-20 relative">
    <!-- Fixed Hardware-Accelerated Background -->
    <picture>
      <source srcset="/images/capri/capri-faraglioni-aerial-coastline.webp" type="image/webp" />
      <img
        src="/images/capri/capri-faraglioni-aerial-coastline.jpg"
        alt="Capri Faraglioni Aerial Coastline"
        class="cartier-parallax-bg"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-[#07142E]/65 pointer-events-none"></div>

    <!-- Centered Editorial Typography Overlay -->
    <div class="relative z-10 max-w-4xl mx-auto space-y-6 text-white parallax-quote gsap-reveal">
      <span class="text-brand-gold uppercase tracking-[0.35em] text-xs font-semibold block">
        Maison Philosophy
      </span>
      <h3 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-white font-light leading-tight italic">
        "Every offering presented across Capri DMC is engineered exclusively for luxury travel agencies, Virtuoso advisors, and discerning VIP clients."
      </h3>
      <p class="text-white/70 font-light text-xs sm:text-sm uppercase tracking-[0.25em]">
        Verified On-Island Mastery · Zero Intermediaries
      </p>
    </div>
  </div>

  <!-- =============================================================== -->
  <!-- LAYER 3 (SOLID WHITE): CUSTOM EXPERIENCES EDITORIAL GALLERY     -->
  <!-- =============================================================== -->
  <div id="experiences" class="cartier-layer-solid-white py-28 lg:py-36 px-6 lg:px-16 text-brand-navy">
    <div class="max-w-7xl mx-auto space-y-20 lg:space-y-28">

      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center space-y-4 service-fade-item gsap-reveal">
        <div class="inline-flex items-center justify-center gap-3">
          <span class="w-6 h-[1px] bg-brand-gold"></span>
          <span class="text-brand-gold uppercase tracking-[0.32em] text-[10px] sm:text-xs font-semibold">
            02 · Custom Experiences
          </span>
          <span class="w-6 h-[1px] bg-brand-gold"></span>
        </div>
        <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-brand-navy font-light leading-[1.08]">
          Unpublished Island Privileges
        </h2>
        <p class="text-gray-600 font-light text-base lg:text-lg max-w-2xl mx-auto leading-relaxed">
          Tailored to VIP personal tastes, culinary immersions, sartorial commissions, and secret nature expeditions far removed from standard tourism.
        </p>
      </div>

      <!-- Cartier-Style Flat Editorial Grid: 7 Island Experiences (Generous Whitespace, No Box Borders) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16">
        {customExperiences.map((service, idx) => (
          <div class="space-y-5 group service-fade-item gsap-reveal">
            <!-- Image with smooth hover scale -->
            <div class="img-zoom-container aspect-[16/11] w-full relative overflow-hidden bg-gray-100">
              <picture class="w-full h-full block">
                <source srcset={toWebp(service.image)} type="image/webp" />
                <img
                  src={service.image}
                  alt={service.title}
                  width="800"
                  height="550"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="absolute top-4 left-4">
                <span class="text-[9px] uppercase tracking-[0.2em] text-white bg-[#07142E]/80 backdrop-blur-md px-2.5 py-0.5 font-medium border border-white/10">
                  {service.badge}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="space-y-2">
              <span class="text-[9px] uppercase tracking-[0.25em] text-brand-gold font-semibold block">
                0{idx + 5} · {service.b2b_tag}
              </span>
              <h4 class="font-serif text-2xl text-brand-navy font-normal group-hover:text-brand-gold transition-colors">
                {service.title}
              </h4>
              <p class="text-gray-600 font-light text-xs sm:text-sm leading-relaxed">
                {service.description}
              </p>
            </div>

            <!-- Features -->
            <ul class="space-y-1.5 pt-2 border-t border-gray-100 text-[11px] text-gray-500 font-light">
              {service.b2b_features.slice(0, 2).map((f) => (
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 bg-brand-gold rounded-full"></span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <div class="pt-1">
              <a
                href={emailContact}
                class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-[0.2em] font-semibold text-brand-navy hover:text-brand-gold transition-colors pb-0.5 border-b border-brand-navy/20 hover:border-brand-gold"
              >
                <span>Inquire Experience</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- B2B Dedicated Ground Dispatch Banner (Clean Minimalist Architectural Presentation) -->
      <div class="border-t border-b border-brand-navy/15 py-12 lg:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center service-fade-item gsap-reveal">
        <div class="lg:col-span-8 space-y-3">
          <div class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-brand-gold uppercase tracking-[0.25em] text-[10px] font-semibold">
              24/7 Dedicated Ground Dispatch
            </span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl text-brand-navy font-normal">
            Your On-Island Eyes and Ears Across All Offerings
          </h3>
          <p class="text-gray-600 font-light text-sm sm:text-base leading-relaxed max-w-2xl">
            From last-minute yacht charters and VIP luggage porterage to private in-villa cooking classes and trusted childcare, our native Capri dispatchers coordinate every detail with zero time-zone delay.
          </p>
        </div>

        <div class="lg:col-span-4 flex justify-start lg:justify-end">
          <a
            href={emailContact}
            class="w-full sm:w-auto px-8 py-3.5 bg-brand-gold text-brand-navy text-[11px] uppercase tracking-[0.2em] font-semibold hover:bg-brand-navy hover:text-white transition-all text-center"
          >
            Email Dispatch Desk
          </a>
        </div>
      </div>

    </div>
  </div>

</section>

<!-- GSAP ScrollTrigger for Parallax & Alternating Rows -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
      // Fade in alternating service rows
      gsap.utils.toArray(".service-fade-item").forEach((el) => {
        gsap.fromTo(el,
          { y: 35, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.85,
            ease: "power2.out",
            force3D: true,
            scrollTrigger: {
              trigger: el,
              start: "top 82%",
              once: true
            }
          }
        );
      });

      // Subtle parallax fade on illuminated quotes
      gsap.utils.toArray(".parallax-quote").forEach((quote) => {
        gsap.fromTo(quote,
          { y: 40, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 1,
            ease: "power3.out",
            force3D: true,
            scrollTrigger: {
              trigger: quote,
              start: "top 75%",
              once: true
            }
          }
        );
      });
    }
  });
</script>
