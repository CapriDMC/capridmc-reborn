---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Capri DMC | Your Destination Management Company in Capri</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Proza+Libre:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#10285D] text-[#FFFFFF] min-h-screen flex flex-col m-0" style="font-family: 'Proza Libre', sans-serif;">
    <!-- Navbar Reale -->
    <header class="py-4 px-8 flex justify-between items-center border-b border-[#D4AF37]/20 bg-[#10285D] sticky top-0 z-50">
      <div class="flex items-center gap-4">
        <img src="https://www.capridmc.com/wp-content/uploads/go-x/u/8a15cc76-c507-4b09-84aa-821eaefde7fa/image.png" alt="Capri DMC Logo" class="h-16 w-auto" />
      </div>
      <nav class="hidden md:flex gap-8 text-sm uppercase tracking-[0.15em]">
        <a href="#services" class="hover:text-[#D4AF37] transition-colors duration-300">Services</a>
        <a href="https://www.capridmc.com/contact-us-capri-destination-management-company/" class="border border-[#D4AF37] px-6 py-2 hover:bg-[#D4AF37] hover:text-[#10285D] transition-all duration-300">Appointment</a>
      </nav>
    </header>

    <!-- Hero Section -->
    <main class="flex-grow flex flex-col items-center justify-center text-center px-6 py-32 max-w-5xl mx-auto">
      <h2 class="text-[#D4AF37] tracking-[0.25em] uppercase text-sm mb-8 font-semibold">Your Roots in Capri</h2>
      <h1 class="text-6xl md:text-8xl text-[#FFFFFF] mb-8 leading-tight" style="font-family: 'Cormorant Garamond', serif;">Your Destination Management Company in Capri</h1>
      <p class="text-lg md:text-xl text-[#FFFFFF]/80 max-w-3xl mx-auto leading-relaxed mb-12 font-light">A boutique Destination Management Company providing bespoke travel solutions, exclusive experiences, and local hospitality management on the island of Capri.</p>
      <a href="https://www.capridmc.com/contact-us-capri-destination-management-company/" class="inline-block bg-[#D4AF37] text-[#10285D] uppercase tracking-[0.2em] text-sm px-10 py-5 font-bold hover:bg-[#FFFFFF] transition-colors duration-300">From Capri for Capri</a>
    </main>
  </body>
</html>
