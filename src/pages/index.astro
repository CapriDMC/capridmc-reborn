---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TheAuthority from '../components/TheAuthority.astro';
import BentoGridServices from '../components/BentoGridServices.astro';
import LogisticsMap from '../components/LogisticsMap.astro';
import AdvisorPerks from '../components/AdvisorPerks.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Capri DMC | Luxury Destination Management Company & B2B Tour Operator"
  description="Capri Destination Management Company is the elite B2B spin-off from Nesea Capri Tours & Events. Bespoke private boat tours, weddings, Bar Mitzvah, VIP logistics, and 24/7 on-island operations."
>
  <!-- Navigation Header -->
  <Header />

  <main>
    <!-- 1. Cinematic Mediterranean Hero -->
    <Hero />

    <!-- 2. Pinned Narrative: The Local Authority (Nesea Spin-off) -->
    <TheAuthority />

    <!-- 3. Modern Bento Grid: Exclusive Offerings & Maritime Luxury -->
    <BentoGridServices />

    <!-- 4. Interactive Vector Logistics Map: Airport to 5★ Suite -->
    <LogisticsMap />

    <!-- 5. Advisor Privileges: Net Rates & White-Label Mastery -->
    <AdvisorPerks />
  </main>

  <!-- Luxury Dark Navy Footer -->
  <Footer />
</Layout>