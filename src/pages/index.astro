<!-- Motore GSAP per Animazioni Cinematiche (Astro is:inline previene conflitti) -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Registrazione Plugin ScrollTrigger
    gsap.registerPlugin(ScrollTrigger);

    // 1. Animazione Hero Iniziale (Scena di apertura)
    const heroTl = gsap.timeline();
    heroTl.to("#hero-bg", { scale: 1, duration: 4, ease: "power2.out" }, 0)
          .fromTo(".hero-text", 
            { y: 50, autoAlpha: 0 }, 
            { y: 0, autoAlpha: 1, duration: 1.2, stagger: 0.2, ease: "power3.out" }, 
            0.5
          );

    // 2. Scroll Narrativo (Pinning della parte sinistra)
    // Solo su desktop
    if(window.innerWidth > 768) {
      ScrollTrigger.create({
        trigger: "#story",
        start: "top top",
        end: "bottom bottom",
        pin: "#story-left",
        pinSpacing: false
      });
    }
    
    // Elementi lato destro che compaiono scorrendo
    gsap.utils.toArray('.story-right-item').forEach(item => {
      gsap.fromTo(item, 
        { y: 40, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 1, ease: "power3.out",
          scrollTrigger: {
            trigger: item,
            start: "top 80%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });

    // 3. Bento Grid Staggered Reveal
    const bentoTl = gsap.timeline({
      scrollTrigger: {
        trigger: "#services",
        start: "top 75%",
      }
    });
    
    bentoTl.fromTo(".bento-header", { y: 30, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.8 })
           .fromTo(".bento-box", 
             { y: 50, autoAlpha: 0 }, 
             { y: 0, autoAlpha: 1, duration: 0.8, stagger: 0.15, ease: "power2.out" }, 
             "-=0.4"
           );

    // 4. Mappa Logistica e Disegno del Tracciato
    const mapTl = gsap.timeline({
      scrollTrigger: {
        trigger: "#logistics",
        start: "top 70%",
      }
    });

    mapTl.fromTo(".map-text", { x: -50, autoAlpha: 0 }, { x: 0, autoAlpha: 1, duration: 1, ease: "power3.out" })
         .fromTo(".map-visual", { scale: 0.9, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 1, ease: "power3.out" }, "-=0.5")
         .to(".pin-naples", { autoAlpha: 1, y: -10, duration: 0.5 }, "-=0.2")
         .to(".path-line", { strokeDashoffset: 0, duration: 1.5, ease: "power1.inOut" })
         .to(".pin-capri", { autoAlpha: 1, y: 0, duration: 0.5 });
  });
</script>