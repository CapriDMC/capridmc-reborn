---
import '../styles/global.css';
import legacyRedirects from '../data/legacy-redirects.json';

const redirectsJson = JSON.stringify(legacyRedirects);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Capri DMC | Page Not Found</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Proza+Libre:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ redirectsJson }}>
      (function () {
        try {
          var map = JSON.parse(redirectsJson);
          var rawPath = window.location.pathname || '/';
          var cleanPath = rawPath.toLowerCase().replace(/\/+$/, '') || '/';

          if (map[cleanPath]) {
            window.location.replace(map[cleanPath]);
            return;
          }
          if (cleanPath === '/wp-sitemap.xml' || cleanPath === '/wp-sitemap-posts-page-1.xml') {
            window.location.replace('/sitemap-index.xml');
            return;
          }
          if (cleanPath.indexOf('/wp-content/uploads/') === 0) {
            window.location.replace('/logo.png');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-brand-dark text-white min-h-screen flex items-center justify-center px-6 antialiased selection:bg-brand-gold selection:text-brand-navy">
    <main class="max-w-xl w-full text-center space-y-8 py-16">
      <div class="flex flex-col items-center">
        <picture>
          <source srcset="/logo.webp" type="image/webp" />
          <img
            src="/logo.png"
            alt="Capri DMC Official Crest"
            width="88"
            height="88"
            class="w-20 h-20 rounded-full object-contain ring-1 ring-brand-gold/60 p-1 shadow-2xl"
          />
        </picture>
        <span class="text-[10px] uppercase tracking-[0.3em] text-brand-gold font-medium mt-5">
          Capri Destination Management Company
        </span>
      </div>

      <div class="space-y-4">
        <h1 class="font-serif text-4xl sm:text-5xl font-light text-white">
          Page Not Found
        </h1>
        <p class="text-white/70 font-light text-sm sm:text-base leading-relaxed">
          The requested page has moved or is no longer available. Return to our main portfolio to explore bespoke Capri B2B services and on-ground island dispatch.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/"
          class="w-full sm:w-auto px-8 py-3.5 bg-brand-gold text-brand-navy text-[11px] uppercase tracking-[0.2em] font-semibold hover:bg-white transition-all"
        >
          Return to Home
        </a>
        <a
          href="mailto:partnerships@capridmc.com?subject=Inquiry%20Capri%20DMC"
          class="w-full sm:w-auto px-8 py-3.5 border border-white/40 text-white text-[11px] uppercase tracking-[0.2em] font-medium hover:bg-white hover:text-brand-navy transition-all"
        >
          Contact Us
        </a>
      </div>
    </main>
  </body>
</html>
