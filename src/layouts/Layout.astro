---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import GoogleTracking from '../components/GoogleTracking.astro';
import CookieConsent from '../components/CookieConsent.astro';
import AmbientAudio from '../components/AmbientAudio.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
}

const {
  title,
  description,
  ogImage,
  lang = "en"
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Google Tracking Suite & Google Consent Mode v2 -->
    <GoogleTracking />

    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      lang={lang}
    />

    <!-- Preload LCP Hero Image for Core Web Vitals (WebP 29KB) -->
    <link
      rel="preload"
      as="image"
      href="/images/capri/capri-mediterranean-sea-horizon-hero.webp"
      type="image/webp"
      fetchpriority="high"
    />

    <!-- Editorial Google Fonts (Cormorant Garamond & Proza Libre) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Proza+Libre:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) for Schema.org, Search & GEO -->
    <JsonLd />

    <!-- GSAP Animation Engine -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  </head>
  <body class="bg-white text-brand-navy antialiased selection:bg-brand-gold selection:text-brand-navy">
    <slot />

    <!-- GSAP Global Orchestrator -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
          gsap.registerPlugin(ScrollTrigger);

          // Configure GSAP defaults
          gsap.defaults({
            ease: "power3.out",
            duration: 1
          });

          // Smart Cartier-Style Auto-Hide / Auto-Reveal Navigation Bar
          const navbar = document.getElementById("navbar");
          if (navbar) {
            let lastScrollY = window.scrollY;
            let isNavHidden = false;
            let ticking = false;

            window.addEventListener("scroll", () => {
              if (!ticking) {
                requestAnimationFrame(() => {
                  const currentScrollY = window.scrollY;

                  if (currentScrollY <= 40) {
                    // Top of page
                    navbar.classList.remove("-translate-y-full", "bg-[#07142E]/95", "backdrop-blur-md", "shadow-xl", "py-4");
                    navbar.classList.add("bg-transparent", "py-5");
                    isNavHidden = false;
                  } else if (currentScrollY > lastScrollY && currentScrollY > 120) {
                    // Scrolling DOWN -> Hide smoothly
                    if (!isNavHidden) {
                      navbar.classList.add("-translate-y-full");
                      isNavHidden = true;
                    }
                  } else if (currentScrollY < lastScrollY) {
                    // Scrolling UP -> Reveal smoothly with luxury frosted backdrop
                    if (isNavHidden) {
                      navbar.classList.remove("-translate-y-full", "bg-transparent", "py-5");
                      navbar.classList.add("bg-[#07142E]/95", "backdrop-blur-md", "shadow-xl", "py-4");
                      isNavHidden = false;
                    }
                  }
                  lastScrollY = currentScrollY;
                  ticking = false;
                });
                ticking = true;
              }
            }, { passive: true });
          }

          // Refresh triggers on window resize
          let resizeTimer;
          window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
              ScrollTrigger.refresh();
            }, 250);
          });
        }
      });
    </script>

    <!-- Ambient Sea Waves Sound Controller -->
    <AmbientAudio />

    <!-- Cookie & Privacy Consent Manager (GDPR / Garante Privacy) -->
    <CookieConsent />
  </body>
</html>
