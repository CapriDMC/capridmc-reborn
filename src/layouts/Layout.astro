---
import '../styles/global.css';
import GeoSchema from '../components/GeoSchema.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Capri DMC | Luxury Destination Management Company & B2B Tour Operator",
  description = "Capri Destination Management Company is the luxury B2B spin-off from Nesea Capri Tours & Events. Bespoke private boat tours, weddings, Bar Mitzvah, VIP logistics, and 24/7 on-island operations.",
  ogImage = "https://www.capridmc.com/images/capri/faraglioni-rocks-guided-tour-private-boat.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://www.capridmc.com");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Capri Destination Management Company" />
    <meta name="keywords" content="Capri DMC, Destination Management Company Capri, Capri Private Boat Tours, Capri Weddings, Bar Mitzvah Capri, Luxury Capri Transfers, Nesea Capri, B2B Travel Advisor Capri" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Capri DMC" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- AI & GEO Discovery Directives -->
    <link rel="ai-context" href="/ai-context.txt" />
    <meta name="generator" content={Astro.generator} />

    <!-- Editorial Google Fonts (Cormorant Garamond & Proza Libre) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600;1,700&family=Proza+Libre:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) for GEO & SEO -->
    <GeoSchema />

    <!-- GSAP Animation Engine -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  </head>
  <body class="bg-white text-brand-navy antialiased selection:bg-brand-gold selection:text-brand-navy">
    <slot />

    <!-- GSAP Global Orchestrator -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
          gsap.registerPlugin(ScrollTrigger);

          // Configure GSAP defaults
          gsap.defaults({
            ease: "power3.out",
            duration: 1
          });

          // Navbar Scroll Effect
          const navbar = document.getElementById("navbar");
          if (navbar) {
            window.addEventListener("scroll", () => {
              if (window.scrollY > 50) {
                navbar.classList.add("bg-brand-navy/95", "backdrop-blur-md", "shadow-xl", "py-3");
                navbar.classList.remove("py-5", "bg-brand-navy/60");
              } else {
                navbar.classList.remove("bg-brand-navy/95", "shadow-xl", "py-3");
                navbar.classList.add("py-5", "bg-brand-navy/60");
              }
            }, { passive: true });
          }

          // Mobile Navigation Menu Toggle
          const menuBtn = document.getElementById("mobile-menu-btn");
          const mobileDrawer = document.getElementById("mobile-drawer");
          const closeDrawerBtn = document.getElementById("close-drawer-btn");
          const drawerLinks = document.querySelectorAll(".drawer-link");

          function toggleDrawer(open) {
            if (!mobileDrawer) return;
            if (open) {
              mobileDrawer.classList.remove("pointer-events-none", "opacity-0");
              mobileDrawer.classList.add("pointer-events-auto", "opacity-100");
              document.body.classList.add("overflow-hidden");
            } else {
              mobileDrawer.classList.add("pointer-events-none", "opacity-0");
              mobileDrawer.classList.remove("pointer-events-auto", "opacity-100");
              document.body.classList.remove("overflow-hidden");
            }
          }

          if (menuBtn) menuBtn.addEventListener("click", () => toggleDrawer(true));
          if (closeDrawerBtn) closeDrawerBtn.addEventListener("click", () => toggleDrawer(false));
          drawerLinks.forEach(link => link.addEventListener("click", () => toggleDrawer(false)));

          // Refresh triggers on window resize
          let resizeTimer;
          window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
              ScrollTrigger.refresh();
            }, 250);
          });
        }
      });
    </script>
  </body>
</html>
